#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"

# Include the deployment timestamp in the commit that will be pushed.
updated_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
printf '// Дата последнего обновления сайта.\nexport const updatedAt = "%s";\n' "$updated_at" > src/data/siteUpdated.ts
git add -- src/data/siteUpdated.ts
