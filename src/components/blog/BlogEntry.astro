---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { localizePath, useTranslations } from "@/i18n";
import { blogRssPath, getBlogEntries } from "@/lib/blog";
import { Icon } from "astro-icon/components";

// Разметка повторяет heroui.com/blog/<post>: колонка 720px, обложка 880px, оглавление справа.
interface Props { entry: CollectionEntry<"blog"> }
const { entry } = Astro.props;
const { data } = entry;
const t = useTranslations(data.locale);
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);
const dateFormat = new Intl.DateTimeFormat(data.locale, { day: "numeric", month: "long", year: "numeric" });
const cover = data.cover ?? "/images/blog/default.svg";
const related = (await getBlogEntries(data.locale))
	.filter((item) => item.id !== entry.id)
	.sort((a, b) => Number(b.data.category === data.category) - Number(a.data.category === data.category))
	.slice(0, 3);
const column = "xl:grid xl:grid-cols-[1fr_minmax(0,720px)_1fr] xl:gap-8";
---

<Layout title={data.title} description={data.description} type="article" ogImage={cover.replace(/\.svg$/, ".png")} datePublished={data.pubDate} dateModified={data.updatedDate} alternates={[]} rssURL={blogRssPath(data.locale)}>
	<main class="pb-16">
		<article>
			<header class="pt-8 sm:pt-[72px]">
				<div class={column}>
					<div class="mx-auto flex max-w-[720px] flex-col gap-5 sm:gap-6 xl:col-start-2 xl:mx-0">
						<nav aria-label={t("blog.breadcrumb")} class="flex items-center gap-2 text-sm leading-5">
							<a href={localizePath(data.locale, "/blog/")} class="text-muted-foreground transition-colors hover:text-foreground">{t("nav.blog")}</a>
							<Icon name="mdi:chevron-right" class="size-4 text-muted-foreground" aria-hidden="true" />
							<span aria-current="page" class="font-medium">{t(`blog.${data.category}`)}</span>
						</nav>
						<h1 class="font-heading text-[34px] leading-[38px] font-medium tracking-[-0.02em] text-balance sm:text-5xl sm:leading-[54px]">{data.title}</h1>
						<p class="text-base leading-[26px] text-pretty text-muted-foreground sm:text-lg sm:leading-[29px]">{data.description}</p>
						<p class="flex flex-wrap items-center gap-2 text-sm leading-5">
							<img src="/favicon.svg" alt="" width="22" height="22" class="size-[22px] shrink-0 rounded-full" />
							<span class="font-medium">{data.author}</span>
							<span aria-hidden="true" class="px-1 text-muted-foreground">·</span>
							<time datetime={data.pubDate.toISOString()} class="text-muted-foreground">{dateFormat.format(data.pubDate)}</time>
							{data.updatedDate && <span class="text-muted-foreground">({t("blog.updated").toLowerCase()} <time datetime={data.updatedDate.toISOString()}>{dateFormat.format(data.updatedDate)}</time>)</span>}
						</p>
						{/* Google Preferred Sources: обычная ссылка вместо скрипта publisher.js - без стороннего JS и в стиле сайта. */}
						<a href="https://www.google.com/preferences/source?q=tatarverse.cc" target="_blank" rel="noopener" class="flex w-fit max-w-full items-center gap-3 rounded-2xl border border-border-muted px-4 py-3 transition-colors hover:bg-muted">
							<svg viewBox="0 0 48 48" width="24" height="24" aria-hidden="true" class="size-6 shrink-0">
								<path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
								<path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
								<path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
								<path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
							</svg>
							<span class="flex min-w-0 flex-col">
								<span class="text-sm leading-5 font-medium">{t("blog.googleSource")}</span>
								<span class="text-[13px] leading-[18px] text-muted-foreground">{t("blog.googleSourceHint")}</span>
							</span>
						</a>
					</div>
				</div>
				<div class="mx-auto mt-8 max-w-[880px] rounded-[24px] bg-muted p-1 sm:mt-10 sm:rounded-[28px]">
					<span class="relative block aspect-[872/458] overflow-hidden rounded-[20px] bg-background sm:rounded-[24px]">
						<img src={cover} alt="" width="1112" height="560" class="absolute inset-0 size-full object-cover" />
					</span>
				</div>
			</header>

			<div class={`mt-10 sm:mt-12 xl:items-start ${column}`}>
				<div class="blog-body mx-auto flex max-w-[720px] min-w-0 flex-col gap-5 xl:col-start-2 xl:mx-0">
					<Content />
				</div>
				{toc.length > 1 && (
					<aside class="hidden xl:sticky xl:top-28 xl:col-start-3 xl:block xl:w-[184px]">
						<nav aria-labelledby="toc-heading" class="pt-1">
							<p id="toc-heading" class="text-[13px] leading-5 font-medium">{t("blog.toc")}</p>
							<ul class="relative mt-3 max-h-[calc(100svh-18rem)] overflow-y-auto [scrollbar-width:none]">
								<span data-toc-indicator aria-hidden="true" class="absolute top-0 left-0 h-0 w-0.5 rounded-full bg-foreground opacity-0 transition-[translate,height,opacity] duration-300 ease-out motion-reduce:transition-none"></span>
								{toc.map((heading) => (
									<li><a href={`#${heading.slug}`} data-toc-link class="block border-l border-border-muted py-[5px] pl-3 text-[13px] leading-[18px] text-muted-foreground transition-[color,padding] duration-300 hover:text-foreground aria-[current=location]:pl-4 aria-[current=location]:font-medium aria-[current=location]:text-foreground motion-reduce:transition-none">{heading.text}</a></li>
								))}
							</ul>
						</nav>
					</aside>
				)}
			</div>
		</article>

		{related.length > 0 && (
			<section aria-labelledby="related-posts-heading" class="mt-20 sm:mt-24">
				<div class="mx-auto max-w-[880px]">
					<h2 id="related-posts-heading" class="font-heading text-xl leading-7 font-medium tracking-[-0.01em]">{t("blog.related")}</h2>
					<ul class="mt-5 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
						{related.map((item) => (
							<li>
								<a href={localizePath(data.locale, `/blog/${item.id}/`)} class="group relative flex h-full flex-col rounded-3xl bg-surface p-1 shadow-[0_0_0_1px_#0000000d,0_1px_2px_#0000000a]">
									<span class="relative block aspect-[360/203] shrink-0 overflow-hidden rounded-[20px] bg-background">
										<img src={item.data.cover ?? "/images/blog/default.svg"} alt="" width="1112" height="560" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02] motion-reduce:transition-none" />
									</span>
									<span class="flex flex-col gap-3 px-4 pt-4 pb-[18px]">
										<span class="line-clamp-2 text-sm leading-5 font-medium text-pretty">{item.data.title}</span>
										<span class="mt-auto flex min-w-0 items-center gap-2 text-[13px] leading-[18px]">
											<img src="/favicon.svg" alt="" width="18" height="18" loading="lazy" class="size-[1.375em] shrink-0 rounded-full" />
											<span class="truncate font-medium">{item.data.author}</span>
											<time datetime={item.data.pubDate.toISOString()} class="shrink-0 text-muted-foreground">{dateFormat.format(item.data.pubDate)}</time>
										</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)}

		<section aria-labelledby="cta-heading" class="flex flex-col items-center pt-24 text-center sm:pt-32">
			<h2 id="cta-heading" class="font-heading text-4xl leading-[44px] font-medium tracking-[-0.02em] sm:text-5xl sm:leading-[54px]">
				<span class="block">{t("blog.ctaTitle")}</span>
				<span class="block text-muted-foreground/70">{t("blog.ctaSubtitle")}</span>
			</h2>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-3 max-sm:w-full max-sm:flex-col max-sm:gap-2.5 sm:mt-10">
				<a href={localizePath(data.locale, "/centers/")} class="inline-flex h-10 items-center justify-center rounded-full bg-primary px-5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 max-sm:w-full">{t("blog.ctaCenters")}</a>
				<a href={localizePath(data.locale, "/nearby/")} class="inline-flex h-10 items-center justify-center rounded-full bg-muted px-5 text-sm font-medium transition-colors hover:bg-subtle max-sm:w-full">{t("blog.ctaNearby")}</a>
			</div>
		</section>
	</main>
</Layout>

<style is:global>
	.blog-body > p,
	.blog-body li {
		font-size: 1rem;
		line-height: 1.75rem;
	}
	.blog-body > h2 {
		margin-top: 1.75rem;
		font-family: var(--font-heading);
		font-size: 1.5rem;
		line-height: 2rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		scroll-margin-top: 6rem;
	}
	.blog-body > h3 {
		margin-top: 0.75rem;
		font-family: var(--font-heading);
		font-size: 1.125rem;
		line-height: 1.75rem;
		font-weight: 500;
		scroll-margin-top: 6rem;
	}
	.blog-body a {
		color: var(--color-link);
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: color-mix(in oklab, var(--color-link-decoration) 35%, transparent);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 3px;
		border-radius: 3px;
		transition: text-decoration-color 150ms, background-color 150ms;
	}
	.blog-body a:hover {
		text-decoration-color: var(--color-link-decoration);
		background-color: color-mix(in oklab, var(--color-link-decoration) 8%, transparent);
	}
	.blog-body a:focus-visible {
		outline: 2px solid var(--color-link-decoration);
		outline-offset: 2px;
	}
	/* Внешние ссылки - со стрелкой, чтобы было видно, что уводят с сайта. */
	.blog-body a[href^="http"]::after {
		content: "↗";
		display: inline-block;
		margin-left: 0.125em;
		font-size: 0.8em;
		text-decoration: none;
		opacity: 0.7;
		transition: translate 150ms;
	}
	.blog-body a[href^="http"]:hover::after {
		translate: 1px -1px;
	}
	.blog-body strong {
		font-weight: 500;
	}
	.blog-body ul,
	.blog-body ol {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.blog-body ul > li {
		position: relative;
		padding-left: 1.25rem;
	}
	.blog-body ul > li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 11px;
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 9999px;
		background: var(--color-subtle);
	}
	.blog-body ol {
		list-style: decimal;
		padding-left: 1.25rem;
	}
	.blog-body li > ul,
	.blog-body li > ol {
		margin-top: 0.5rem;
	}
	.blog-body code {
		border: 1px solid var(--color-border-muted);
		border-radius: 5px;
		padding: 3px;
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 0.8125em;
	}
	.blog-body blockquote {
		border-left: 2px solid var(--color-border-muted);
		padding-left: 1rem;
		color: var(--color-muted-foreground);
	}
	.blog-body hr {
		border-color: var(--color-border-muted);
	}
	/* Скриншоты в тексте: светлые края не должны сливаться с фоном страницы. */
	.blog-body img {
		border: 1px solid var(--color-border-muted);
		border-radius: 12px;
	}
	.blog-body table {
		width: 100%;
		font-size: 0.9375rem;
		line-height: 1.5rem;
	}
	.blog-body th,
	.blog-body td {
		border-bottom: 1px solid var(--color-border-muted);
		padding: 0.5rem 0.75rem 0.5rem 0;
		text-align: left;
		vertical-align: top;
	}
	.blog-body th {
		font-weight: 500;
	}
</style>

<script>
	// Подсветка текущего раздела в оглавлении, как на heroui.com.
	const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
	const sections = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter(Boolean) as HTMLElement[];
	if (sections.length) {
		const indicator = document.querySelector<HTMLElement>("[data-toc-indicator]");
		const update = () => {
			let current = sections[0];
			for (const section of sections) if (section.getBoundingClientRect().top < 140) current = section;
			for (const link of links) {
				if (decodeURIComponent(link.hash) === `#${current.id}`) link.setAttribute("aria-current", "location");
				else link.removeAttribute("aria-current");
			}
			// Полоска плавно переезжает к текущему пункту.
			const active = links.find((link) => decodeURIComponent(link.hash) === `#${current.id}`);
			if (indicator && active) {
				indicator.style.translate = `0 ${active.offsetTop}px`;
				indicator.style.height = `${active.offsetHeight}px`;
				indicator.style.opacity = "1";
			}
		};
		document.addEventListener("scroll", update, { passive: true });
		update();
	}
</script>
