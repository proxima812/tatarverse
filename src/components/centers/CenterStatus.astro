---
import { config } from "@/config";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import type { CenterCompleteness } from "@/lib/center/completeness";
import { Icon } from "astro-icon/components";

/**
 * Полнота карточки: «заполнена» или «данные неполные» со списком пробелов и
 * просьбой помочь. Статус считается при сборке из самой карточки
 * (getCenterCompleteness), руками не ставится.
 *
 * Неполная карточка - баннер в светлой рамке, как промо-блок на главной
 * Cloudflare: значок слева, текст, кнопки справа.
 */
interface Props {
	completeness: CenterCompleteness;
	centerTitle: string;
	class?: string;
}

const { completeness, centerTitle, class: className } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const centerId = Astro.params.id ?? "";
const cardUrl = new URL(Astro.url.pathname, config.site.url).href;
const message = t("detail.status.message", { id: centerId, title: centerTitle, url: cardUrl });
const telegramUrl = `https://t.me/mirikhan1?text=${encodeURIComponent(message)}`;
const whatsappUrl = `https://wa.me/79172975109?text=${encodeURIComponent(message)}`;

/*
 * Кнопки мессенджеров - та же акцентная схема (btn-gradient), что у
 * остальных: градиент, блик, обводка в тон, свечение - только в цветах
 * Telegram и WhatsApp. Зелёный темнее фирменного #25D366: на нём белый
 * текст не читался. Классы целиком литералами: Tailwind ищет их в исходнике.
 */
const brandClass = "[--accent-lift:18%] [--accent-glow-amount:35%] [--color-accent-foreground:#fff]";
const telegramClass = `${brandClass} [--color-accent:#1E8FD6]`;
const whatsappClass = `${brandClass} [--color-accent:#1DA851]`;

const gaps = completeness.gaps.map((gap) => t(`detail.gap.${gap}`)).join(", ");
---

{
	completeness.complete ? (
		<p class:list={["not-prose flex items-start justify-center gap-2 text-sm", className]}>
			<Icon name="tabler:circle-check" class="mt-0.5 size-4 shrink-0 text-foreground" aria-hidden="true" />
			<span>
				<span class="block font-medium text-foreground">{t("detail.status.complete")}</span>
				<span class="block text-xs text-subtle-foreground">{t("detail.status.completeHint")}</span>
			</span>
		</p>
	) : (
		<section
			class:list={["not-prose field-well rounded-catalog corner-squircle p-1.5 text-sm", className]}
			aria-labelledby="center-status"
		>
			<div class="field-lift flex flex-col gap-4 rounded-[calc(var(--radius-catalog)-6px)] corner-squircle bg-surface p-4 sm:p-5 lg:flex-row lg:items-center">
				<span class="grid size-12 shrink-0 place-items-center rounded-control corner-squircle bg-muted text-foreground">
					<Icon name="tabler:circle-dashed" class="size-6" aria-hidden="true" />
				</span>
				<div class="min-w-0 flex-1 space-y-1">
					<h2 id="center-status" class="text-base font-semibold text-foreground">
						{t("detail.status.incomplete")}{" "}
						<span class="font-normal text-muted-foreground">- {t("detail.status.missing", { gaps })}</span>
					</h2>
					<p class="text-subtle-foreground">{t("detail.status.help")}</p>
				</div>
				<div class="flex shrink-0 flex-wrap gap-2">
					<ButtonLink
						href="https://t.me/the_tatarverse/57"
						target="_blank"
						variant="gradient"
						class={telegramClass}
						size="xs"
						icon="mdi:telegram"
						label={t("detail.status.cta")}
					/>
					<ButtonLink
						href={telegramUrl}
						target="_blank"
						variant="gradient"
						class={telegramClass}
						size="xs"
						icon="mdi:telegram"
						label={t("detail.status.telegram")}
					/>
					<ButtonLink
						href={whatsappUrl}
						target="_blank"
						variant="gradient"
						class={whatsappClass}
						size="xs"
						icon="mdi:whatsapp"
						label={t("detail.status.whatsapp")}
					/>
				</div>
			</div>
		</section>
	)
}
