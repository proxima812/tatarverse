---
import CenterBody from "@/components/centers/CenterBody.astro";
import CenterColumns from "@/components/centers/CenterColumns.astro";
import CenterHeader from "@/components/centers/CenterHeader.astro";
import CenterPagination from "@/components/centers/CenterPagination.astro";
import CenterStatus from "@/components/centers/CenterStatus.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import CopyPageMenu from "@/components/ui/CopyPageMenu.astro";
import TranslationFeedbackCard from "@/components/ui/TranslationFeedbackCard.astro";
import { hasLocalizedRoute, localizePath, useTranslations, type AppLocale } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { cardDetail } from "@/lib/center/cardDetail";
import { centerMarkdownURL, centerPath } from "@/lib/server/centerPage";
import { inSnapshot, type CenterLinkItem } from "@/lib/center/catalogMeta";
import type { PublicCenterCard } from "@/lib/tvapi/client";

/**
 * Страница центра - одна на все центры, по коду из адреса (`/centers/tbk-N/`, `/en/centers/tbk-N/`).
 * Рендерится по запросу из карточки API (`pages/centers/[id].astro`), поэтому новый или поправленный
 * центр сразу на сайте, а поисковики получают готовый HTML: шапку, ссылки, сведения, текст и JSON-LD.
 */
interface Props {
	card: PublicCenterCard;
	ruCard: PublicCenterCard;
	code: string;
	locale: AppLocale;
	related: CenterLinkItem[];
	previous: CenterLinkItem | null;
	next: CenterLinkItem | null;
}

const { card, ruCard, code, locale, related, previous, next } = Astro.props as Props;
const t = useTranslations(locale);

const canonicalURL = centerPath(locale, code);
const detail = cardDetail(card, { locale, t, canonicalURL, related, ruCard });

// Английская версия объявляется там, где она есть в выгрузке (centers.meta.json), - как у собранных страниц.
const hasEnglish = locale === "en" || hasLocalizedRoute("en", `centers/${code}`);
const alternates = [
	{ hreflang: "ru", href: centerPath("ru", code) },
	...(hasEnglish ? [{ hreflang: "en", href: centerPath("en", code) }] : []),
	{ hreflang: "x-default", href: centerPath("ru", code) },
];

// OG-картинка и Markdown-двойник собираются из выгрузки: центру, одобренному после неё, - общая картинка
// и без двойника, чтобы не ссылаться на 404.
const built = inSnapshot(code);
const markdownURL = centerMarkdownURL(locale, code);
---

<Layout
	title={detail.title}
	description={detail.description}
	type="article"
	ogImage={built ? `/og/centers/${code}.png` : undefined}
	canonicalURL={canonicalURL}
	markdownURL={markdownURL}
	alternates={alternates}
	datePublished={detail.publishedDate}
	dateModified={detail.modifiedDate}
>
	<article class="mx-auto flex w-full max-w-5xl min-w-0 flex-col gap-10">
		<nav class="flex w-full flex-wrap items-center justify-between gap-3">
			<ButtonLink
				href={localizePath(locale, "/centers")}
				labelKey="nav.allCenters"
				variant="outline"
				icon="tabler:arrow-back-up"
			/>
			<CopyPageMenu class="max-w-full justify-self-start sm:justify-self-end" />
		</nav>

		<CenterHeader
			id={card.id}
			title={detail.title}
			summary={detail.summary}
			badges={detail.badges}
			place={detail.place}
		/>

		<CenterColumns
			linkRows={detail.linkRows}
			facts={detail.facts}
			sourceUrl={detail.sourceUrl}
			sourceLabel={detail.sourceLabel}
			related={detail.related}
			relatedTitle={detail.relatedTitle}
		/>

		{/* Раздел «Ссылки» в тексте не рисуется: его строки уже стоят колонкой выше. */}
		<div class="center-prose prose mx-auto w-full max-w-3xl min-w-0">
			<CenterBody card={card} lang={locale} />
		</div>

		<CenterStatus code={code} completeness={detail.completeness} />

		<CenterPagination previousEntry={previous} nextEntry={next} />

		<TranslationFeedbackCard code={code} />
	</article>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(detail.jsonLd)} />
</Layout>
