---

interface Props {
	group: string;
	label: string;
	value?: string;
	count?: number;
	flag?: string;
	all?: boolean;
}

const { group, label, value, count, flag, all = false } = Astro.props as Props;

---

<button
	type="button"
	data-filter-chip={all ? undefined : group}
	data-filter-all={all ? group : undefined}
	data-filter-value={all ? undefined : value}
	data-active={all ? "" : undefined}
	aria-pressed={all ? "true" : "false"}
	class="catalog-filter-chip group"
>
	{flag && <span class="shrink-0 text-sm leading-none">{flag}</span>}
	<span class="min-w-0 truncate" data-chip-label>{label}</span>
	{
		count !== undefined && (
			<span class="catalog-filter-count" data-chip-count>
				{count}
			</span>
		)
	}
</button>
