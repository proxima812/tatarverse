---
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import type { Facet } from "@/lib/center/facets";
import { Icon } from "astro-icon/components";
import FilterChip from "./FilterChip.astro";

interface Props {
	facet: Facet;
	gate?: string;
}

const { facet, gate = "always" } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

/** С этого числа опций в секции появляется поле «найти в списке». */
const FACET_FILTER_THRESHOLD = 12;
const showFacetFilter = facet.options.length >= FACET_FILTER_THRESHOLD;

const moreButtonClass =
	"mt-0.5 inline-flex max-w-fit cursor-pointer text-xs font-medium text-muted-foreground underline decoration-border underline-offset-4 transition hover:text-foreground lg:mt-1 lg:px-2";
---

<details
	class="group/facet border-b border-depth-100 pb-3 last:border-b-0 last:pb-0"
	data-filter-section={facet.key}
	data-filter-gate={gate}
	hidden
	open
>
	<summary
		class="flex cursor-pointer list-none items-center gap-2 py-1 select-none [&::-webkit-details-marker]:hidden"
	>
		<span class="text-sm font-semibold text-surface-foreground">{t(facet.titleKey)}</span>
		<span
			data-section-badge
			hidden
			class="min-w-4 rounded-full bg-accent px-1.5 text-center text-xs font-semibold tabular-nums text-accent-foreground"
		>
		</span>
		<Icon
			name="mdi:chevron-down"
			class="ml-auto size-4 shrink-0 text-subtle-foreground transition-transform group-open/facet:rotate-180"
			aria-hidden="true"
		/>
	</summary>

	{
		showFacetFilter && (
			<label class="relative mt-1 mb-2 block">
				<span class="sr-only">{t("list.facetFilter")}</span>
				<Icon
					name="mdi:magnify"
					class="pointer-events-none absolute top-1/2 left-2.5 size-4 -translate-y-1/2 text-subtle-foreground"
					aria-hidden="true"
				/>
				<input
					type="search"
					data-facet-filter={facet.key}
					placeholder={t("list.facetFilter")}
					autocomplete="off"
					class="w-full rounded-control corner-squircle bg-surface-muted py-1.5 pr-2.5 pl-8 text-sm text-surface-foreground outline-none placeholder:text-subtle-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-search-cancel-button]:hidden"
				/>
			</label>
		)
	}

	<div
		class="flex flex-wrap items-center gap-1.5 pt-1 lg:flex-col lg:items-stretch lg:gap-0.5"
		role="group"
		aria-label={t(facet.ariaKey)}
		data-filter-group={facet.key}
		data-filter-limit={facet.limit}
	>
		<FilterChip group={facet.key} label={t(facet.allKey)} all />

		{
			facet.options.map((option) => (
				<FilterChip
					group={facet.key}
					value={option.value}
					label={option.label}
					count={option.count}
					flag={option.flag}
				/>
			))
		}
	</div>

	<button
		type="button"
		class={moreButtonClass}
		data-filter-more={facet.key}
		data-expanded="false"
		data-show-more={t("list.showMore", { count: "__COUNT__" })}
		data-show-less={t("list.showLess")}
		hidden
	>
	</button>
</details>
