---
import CenterCard from "@/components/centers/CenterCard.astro";
import CardSkeleton from "@/components/centers/CardSkeleton.astro";
import { cardGeo, type CatalogCard } from "@/lib/center/catalogCards";
import { getLocaleFromUrl, useTranslations } from "@/i18n";

interface Props {
	/** Первая порция: остальное браузер догружает по прокрутке. */
	cards: CatalogCard[];
	/** Сколько карточек всего - есть ли что догружать. */
	total: number;
}

const { cards, total } = Astro.props as Props;
const t = useTranslations(getLocaleFromUrl(Astro.url));
const SKELETONS = 4;
---

<section
	id="cards-grid"
	class="grid scroll-mt-28 grid-cols-1 gap-6 md:grid-cols-2"
>
	{
		cards.map((card) => (
			<CenterCard
				id={card.id}
				title={card.title}
				summary={card.summary}
				type={card.type}
				category={card.category}
				location={{ flag: card.flag }}
				geo={cardGeo(card)}
				pubDate={card.pubDate}
				linkHref={card.linkHref}
			/>
		))
	}
</section>

<!-- Хвост сетки: пока есть что догружать, здесь скелетоны, и до них
     долистывают - тогда браузер дорисовывает следующую порцию. -->
<div
	data-catalog-more
	hidden={cards.length >= total}
	role="status"
	aria-label={t("list.loadingMore")}
	class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2"
>
	{Array.from({ length: SKELETONS }, () => <CardSkeleton />)}
</div>
