---
import A from "@/components/markdown/A.astro";
import { autolink, smartText } from "@/lib/center/autolink";

/** Текст карточки как в Markdown собранной страницы: голые адреса - ссылками (GFM), кавычки и тире - smartypants. */
interface Props {
	text: string;
}

const parts = autolink(Astro.props.text);
---

{parts.map((part) => ("url" in part ? <A href={part.url}>{part.url}</A> : smartText(part.text)))}
