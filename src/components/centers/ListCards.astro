---
import { facetRecords, payloadScript } from "@/lib/center/catalogCards";
import { catalogSnapshot } from "@/lib/center/catalogSnapshot";
import { buildCenterFacets } from "@/lib/center/facets";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import NoResults from "../ui/NoResults.astro";
import ActiveFilters from "./ActiveFilters.astro";
import CenterCard from "./CenterCard.astro";
import FilterChip from "./FilterChip.astro";
import GridCards from "./GridCards.astro";
import Search from "./Search.astro";
import Toolbar from "./Toolbar.astro";

/** Сколько карточек в HTML: первый экран и ссылки для поисковиков без JS. */
const FIRST_BATCH = 24;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const SORT_OPTIONS = [
	{ value: "recency", labelKey: "list.sort.recency" },
	{ value: "alpha", labelKey: "list.sort.alpha" },
	{ value: "country", labelKey: "list.sort.country" },
] as const;

// Снимок сборки. На проде функция Pages подменяет его свежей выгрузкой API
// прямо в HTML (`functions/_middleware.js`), и браузер рендерит из неё.
const catalog = await catalogSnapshot(locale);
const facets = buildCenterFacets(facetRecords(catalog.cards), locale);
---

<div class="not-container bg-catalog px-5 pt-4 pb-12 sm:px-8 lg:px-12 lg:pt-8">
	<div
		class="grid grid-cols-1 gap-x-8 lg:grid-cols-[var(--catalog-aside)_minmax(0,1fr)] lg:gap-x-[var(--catalog-gap)]"
	>
		<Toolbar facets={facets} />

		<div class="min-w-0">
			<!-- Поиск живёт в колонке карточек: так панель фильтров слева
			     начинается на одном уровне с ним, без пустого отступа сверху. -->
			<div
				data-catalog-bar
				class="sticky top-15 z-30 -mx-5 flex flex-col gap-2 bg-catalog px-5 py-2 sm:-mx-8 sm:px-8 lg:top-0 lg:mx-0 lg:gap-3 lg:px-0 lg:pt-0 lg:pb-4"
			>
				<Search />
				<ActiveFilters />
			</div>

			<div class="mb-4 flex items-center justify-between gap-3">
				<span
					data-results-count
					data-results-template={t("list.results", { count: "__COUNT__" })}
					role="status"
					class="shrink-0 text-sm font-medium text-muted-foreground tabular-nums"
				>
					{t("list.results", { count: String(catalog.cards.length) })}
				</span>
				<label class="flex min-w-0 items-center gap-2 text-sm text-muted-foreground">
					<span class="sr-only">{t("list.sort.label")}</span>
					<select
						data-catalog-sort
						data-relevance-label={t("list.sort.relevance")}
						class="min-w-0 cursor-pointer appearance-none rounded-control corner-squircle bg-surface px-3 py-1.5 text-sm font-medium text-surface-foreground outline-none transition hover:bg-surface-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
					>
						{
							SORT_OPTIONS.map((option) => (
								<option value={option.value}>{t(option.labelKey)}</option>
							))
						}
					</select>
				</label>
			</div>
			<GridCards cards={catalog.cards.slice(0, FIRST_BATCH)} total={catalog.cards.length} />
			<NoResults />
			<div hidden data-live-catalog data-locale={locale}>
				<script is:inline type="application/json" data-catalog-payload set:html={payloadScript(catalog)} />
				<template data-card-template><CenterCard id="" template /></template>
				<template data-chip-template><FilterChip group="" label="" value="" count={0} template /></template>
			</div>
		</div>
	</div>
</div>

