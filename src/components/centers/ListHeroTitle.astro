---
import { getLocaleFromUrl, useTranslations } from "@/i18n";

/**
 * Заголовок каталога скрыт визуально, но остаётся в разметке для SEO и
 * скринридеров: страница начинается сразу с поиска и карточек, а h1 и
 * вводный абзац читают только роботы. Ссылки «Статистика» и «Печать»,
 * жившие в герое, переехали в низ панели фильтров (`Toolbar.astro`).
 */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<header class="sr-only">
	<h1>{t("list.title")}</h1>
	<p>{t("list.heroIntro")}</p>
</header>
