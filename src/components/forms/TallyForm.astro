---
/**
 * Встраивание формы Tally (https://tally.so). `formId` - только код формы
 * из ссылки `tally.so/embed/<id>`, не весь URL: остальные параметры embed
 * (alignLeft, hideTitle, dynamicHeight) собираются
 * здесь, чтобы вызов оставался `<TallyForm formId="..." title="..." />`,
 * а не строкой query-параметров на каждой странице.
 *
 * Фон у формы свой, не прозрачный: текст Tally темный и в темной теме
 * сайта на прозрачном фоне не читается.
 *
 * Скрипт грузится один раз на страницу и подхватывает все `data-tally-src`
 * на ней разом - несколько форм на одной странице не сломают друг друга.
 */
interface Props {
	formId: string;
	title: string;
	height?: number;
}

const { formId, title, height = 1335 } = Astro.props;

const src = `https://tally.so/embed/${formId}?alignLeft=1&hideTitle=1&dynamicHeight=1`;
---

<div class="not-prose overflow-hidden rounded-catalog corner-squircle">
	<iframe data-tally-src={src} loading="lazy" width="100%" height={height} title={title}
	></iframe>
</div>

<script is:inline>
	(function loadTallyEmbeds() {
		var widgetSrc = "https://tally.so/widgets/embed.js";
		var d = document;

		function fillEmbeds() {
			if (typeof Tally !== "undefined") {
				Tally.loadEmbeds();
				return;
			}
			for (const el of d.querySelectorAll("iframe[data-tally-src]:not([src])")) {
				el.src = el.dataset.tallySrc;
			}
		}

		if (typeof Tally !== "undefined") {
			fillEmbeds();
			return;
		}

		/* Скрипт виджета общий на страницу - несколько форм не должны грузить его повторно. */
		if (d.querySelector(`script[src="${widgetSrc}"]`) !== null) {
			return;
		}

		var s = d.createElement("script");
		s.src = widgetSrc;
		s.onload = fillEmbeds;
		s.onerror = fillEmbeds;
		d.body.appendChild(s);
	})();
</script>
