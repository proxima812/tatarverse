---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import MockEdit from "./showcase/MockEdit.astro";

/**
 * Правка карточки: кнопка «Предложить правку» на странице центра открывает
 * форму с текущими данными. Ссылки на саму форму здесь нет - ей нужен код
 * центра, поэтому кнопка ведёт в каталог.
 */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section aria-labelledby="home-edit" class="home-section">
	<div class="home-section-head">
		<HomeSectionHeading id="home-edit" section="edit" />
		<div class="space-y-4">
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.edit.text1")}</p>
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.edit.text2")}</p>
			<ButtonLink
				href="/centers"
				labelKey="home.edit.cta"
				label="Найти центр"
				icon="tabler:pencil"
				variant="gradient"
			/>
		</div>
	</div>

	<div class="home-section-stage">
		<MockEdit />
	</div>
</section>
