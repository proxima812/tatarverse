---
import { getLocaleFromUrl, useTranslations, type AppLocale } from "@/i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

type Cell = { key: string; muted?: boolean };

const cells: Cell[] = [
	{ key: "home.hero.1" },
	{ key: "home.hero.6", muted: true },
	{ key: "home.hero.3" },
	{ key: "home.hero.5", muted: true },
	{ key: "home.hero.2" },
	{ key: "home.hero.7", muted: true },
];

const label = `${t("home.hero.1")} ${t("home.hero.2")} ${t("home.hero.3")}. ${t("home.hero.5")} ${t("home.hero.6")} ${t("home.hero.7")}`;

const heroSizeClass: Record<AppLocale, string> = {
	ru: "text-[clamp(1.25rem,calc(6.9vw-3px),4.4rem)]",
	en: "text-[clamp(1rem,calc(5.6vw-3px),3.6rem)]",
};
---

<h1
	class:list={["relative select-none leading-none", heroSizeClass[locale] ?? heroSizeClass.ru]}
>
	<span class="sr-only">{label}</span>
	<span
		aria-hidden="true"
		class="mx-auto grid w-fit grid-cols-[repeat(3,auto)] items-center justify-center justify-items-center whitespace-nowrap gap-x-[0.4em] gap-y-[0.18em]"
	>
		{
			cells.map(({ key, muted }) => (
				<span
					class:list={[
						"uppercase",
						muted
							? "font-bold tracking-[-0.03em] text-foreground/45"
							: "font-black tracking-[-0.02em] text-foreground",
					]}
				>
					{t(key).replace(/\.$/, "")}
				</span>
			))
		}
	</span>
</h1>
