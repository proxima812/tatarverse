---
import { getLocaleFromUrl, useTranslations, type AppLocale } from "@/i18n";
import { Icon } from "astro-icon/components";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

type Cell = { key: string; icon?: string };

const cells: Cell[] = [
	{ key: "home.hero.1" },
	{ key: "home.hero.6", icon: "qt" },
	{ key: "home.hero.3" },
	{ key: "home.hero.5", icon: "tt" },
	{ key: "home.hero.2" },
	{ key: "home.hero.7", icon: "bs" },
];

const label = `${t("home.hero.1")} ${t("home.hero.2")} ${t("home.hero.3")}. ${t("home.hero.5")} ${t("home.hero.6")} ${t("home.hero.7")}`;

const heroSizeClass: Record<AppLocale, string> = {
	ru: "text-[clamp(1.15rem,calc(6.3vw-3px),4rem)]",
	en: "text-[clamp(0.94rem,calc(5.1vw-3px),3.25rem)]",
};
---

<h1
	class:list={["relative select-none leading-none", heroSizeClass[locale] ?? heroSizeClass.ru]}
>
	<span class="sr-only">{label}</span>
	<span
		aria-hidden="true"
		class="mx-auto grid w-fit grid-cols-[repeat(3,auto)] items-center justify-center justify-items-center whitespace-nowrap gap-x-[0.4em] gap-y-[0.18em]"
	>
		{
			cells.map(({ key, icon }) =>
				icon ? (
					<span class="inline-flex uppercase items-center gap-[0.18em] font-bold tracking-[-0.03em] text-foreground/45">
						{t(key).replace(/\.$/, "")}
						<span class="hero-sign">
							<Icon name={icon} />
						</span>
					</span>
				) : (
					<span class="font-black uppercase tracking-[-0.02em] text-foreground">{t(key)}</span>
				),
			)
		}
	</span>
</h1>
