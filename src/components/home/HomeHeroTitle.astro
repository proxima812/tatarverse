---
import { Icon } from "astro-icon/components";
import { getLocaleFromUrl, useTranslations, type AppLocale } from "@/i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

/** Стопка плиток рядом со словом: знаки народов после «языка», флаги перед «людьми». */
type Cell = { key: string; muted?: boolean; stack?: "after" | "before" };

const cells: Cell[] = [
	{ key: "home.hero.1" },
	{ key: "home.hero.6", muted: true },
	{ key: "home.hero.3" },
	{ key: "home.hero.5", muted: true, stack: "after" },
	{ key: "home.hero.2" },
	{ key: "home.hero.7", muted: true, stack: "before" },
];

const signs = ["bs", "qt", "tt"];
// Флаги градиентами в стиле hypercolor.dev/flags: Россия, Финляндия, Польша.
const flags = [
	"linear-gradient(180deg, #FFF 33.333%, #0039A6 33.333% 66.666%, #D52B1E 66.666%)",
	"linear-gradient(90deg, transparent 28%, #002F6C 28% 46%, transparent 46%), linear-gradient(180deg, #FFF 41%, #002F6C 41% 59%, #FFF 59%)",
	"linear-gradient(180deg, #FFF 50%, #DC143C 50%)",
];

const label = `${t("home.hero.1")} ${t("home.hero.2")} ${t("home.hero.3")}. ${t("home.hero.5")} ${t("home.hero.6")} ${t("home.hero.7")}`;

const heroSizeClass: Record<AppLocale, string> = {
	ru: "text-[clamp(1.1rem,calc(6.1vw-3px),3.9rem)]",
	en: "text-[clamp(0.89rem,calc(4.85vw-3px),3.1rem)]",
};
---

<h1
	class:list={["relative select-none leading-none", heroSizeClass[locale] ?? heroSizeClass.ru]}
>
	<span class="sr-only">{label}</span>
	<span
		aria-hidden="true"
		class="mx-auto grid w-fit grid-cols-[repeat(3,auto)] items-center justify-center justify-items-center whitespace-nowrap gap-x-[0.4em] gap-y-[0.18em]"
	>
		{
			cells.map(({ key, muted, stack }) => {
				const word = (
					<span
						class:list={[
							"uppercase",
							muted
								? "font-bold tracking-[-0.03em] text-foreground/45"
								: "font-black tracking-[-0.02em] text-foreground",
						]}
					>
						{t(key).replace(/\.$/, "")}
					</span>
				);
				if (!stack) return word;
				const tiles =
					stack === "after" ? (
						<span class="hero-stack">
							{signs.map((name) => (
								<span class="hero-tile">
									<Icon name={name} />
								</span>
							))}
						</span>
					) : (
						<span class="hero-stack">
							{flags.map((flag) => (
								<span class="hero-tile hero-tile--flag" style={{ background: flag }} />
							))}
						</span>
					);
				return (
					<span class="flex items-center gap-[0.3em]">
						{stack === "before" && tiles}
						{word}
						{stack === "after" && tiles}
					</span>
				);
			})
		}
	</span>
</h1>
