---
import { Icon } from "astro-icon/components";
import { getLocaleFromUrl, useTranslations, type AppLocale } from "@/i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

type Cell = { key: string; muted?: boolean; stack?: "signs" | "flags" | "faces" };

const rows: Cell[][] = [
	[{ key: "home.hero.1" }, { key: "home.hero.6", muted: true }, { key: "home.hero.3" }],
	[
		{ key: "home.hero.5", muted: true, stack: "signs" },
		{ key: "home.hero.2", stack: "flags" },
		{ key: "home.hero.7", muted: true, stack: "faces" },
	],
];

/** Стопки плиток справа от слов второй строки: знаки народов, флаги стран диаспоры, лица. */
const signs = ["bs", "qt", "tt"];
// Флаги эмодзи: Казахстан, Украина, Россия.
const flags = ["🇰🇿", "🇺🇦", "🇷🇺"];
const faces = ["😀", "😊", "😎"];

const label = `${t("home.hero.1")} ${t("home.hero.2")} ${t("home.hero.3")}. ${t("home.hero.5")} ${t("home.hero.6")} ${t("home.hero.7")}`;

const heroSizeClass: Record<AppLocale, string> = {
	ru: "text-[clamp(1.2rem,calc(6.6vw-3px),3.9rem)]",
	en: "text-[clamp(1.2rem,calc(6.6vw-3px),3.9rem)]",
};
---

<h1
	class:list={["relative select-none leading-none", heroSizeClass[locale] ?? heroSizeClass.ru]}
>
	<span class="sr-only">{label}</span>
	<span
		aria-hidden="true"
		class="flex flex-col items-center gap-y-[0.18em] whitespace-nowrap"
	>
		{rows.map((row) => (
			<span class="flex items-center justify-center gap-x-[0.4em]">
				{row.map(({ key, muted, stack }) => {
				const word = (
					<span
						class:list={[
							"uppercase",
							muted
								? "font-bold tracking-[-0.03em] text-foreground/45"
								: "font-black tracking-[-0.02em] text-foreground",
						]}
					>
						{t(key).replace(/\.$/, "")}
					</span>
				);
				if (!stack) return word;
				return (
					<span class="inline-flex items-center gap-[0.22em]">
						{word}
						<span class="hero-stack">
							{stack === "signs" &&
								signs.map((name) => (
									<span class="hero-tile">
										<Icon name={name} />
									</span>
								))}
							{stack === "flags" &&
								flags.map((flag) => (
									<span class="hero-tile hero-tile--emoji">
										<span>{flag}</span>
									</span>
								))}
							{stack === "faces" &&
								faces.map((face) => (
									<span class="hero-tile hero-tile--emoji"><span>{face}</span></span>
								))}
						</span>
					</span>
				);
				})}
			</span>
		))}
	</span>
</h1>
