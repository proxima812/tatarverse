---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import MockInstagram from "./showcase/MockInstagram.astro";

/** Instagram проекта: приглашение подписаться, тот же адрес, что в подвале. */

const INSTAGRAM_URL = "https://www.instagram.com/the_tatarverse/";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section aria-labelledby="home-instagram" class="home-section">
	<div class="home-section-head">
		<HomeSectionHeading id="home-instagram" section="instagram" />
		<div class="space-y-4">
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.instagram.text1")}</p>
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.instagram.text2")}</p>
			<ButtonLink
				href={INSTAGRAM_URL}
				labelKey="home.instagram.cta"
				label="Открыть Instagram"
				icon="mdi:instagram"
				variant="gradient"
				target="_blank"
			/>
		</div>
	</div>

	<div class="home-section-stage">
		<MockInstagram />
	</div>
</section>
