---
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { getCenterLinks } from "@/lib/center/links";
import { getCollection } from "astro:content";
import ButtonLink from "../ui/ButtonLink.astro";
import MockLinks from "./showcase/MockLinks.astro";

/**
 * Секция про каналы связи: сколько ссылок собрано в каталоге.
 * Ссылки считаются тем же `getCenterLinks`, что рисует их в карточке центра.
 */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

let links = 0;

for (const center of await getCollection("centers")) {
	links += getCenterLinks(center.body, center.data.source).length;
}
---

<section
	aria-labelledby="home-links-showcase"
	class="grid grid-cols-1 items-center gap-6 md:grid-cols-2 md:gap-12"
>
	<div class="space-y-6">
		<h2 id="home-links-showcase" class="text-4xl font-bold tracking-tight">
			{t("home.contacts.title")}
		</h2>
		<p class="leading-7 text-muted-foreground" set:html={t("home.contacts.text", { links })} />
		<p class="leading-7 text-muted-foreground">{t("home.contacts.text2")}</p>
		<ButtonLink
			href="/centers"
			labelKey="nav.viewCenters"
			label="Посмотреть центры"
			icon="mdi:link-variant"
			variant="gradient"
		/>
	</div>

	<MockLinks />
</section>
