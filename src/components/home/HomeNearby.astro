---
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import ButtonLink from "../ui/ButtonLink.astro";
import MockNearby from "./showcase/MockNearby.astro";

/** Поиск по геолокации: обещание раздела `/nearby`. */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section aria-labelledby="home-nearby" class="home-section">
	<div class="home-section-head">
		<HomeSectionHeading id="home-nearby" section="nearby" />
		<div class="space-y-4">
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.nearby.text1")}</p>
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.nearby.text2")}</p>
			<ButtonLink
				href="/nearby"
				labelKey="nav.nearby"
				label="Центры рядом"
				icon="mdi:map-marker-radius-outline"
				variant="gradient"
			/>
		</div>
	</div>

	<div class="home-section-stage">
		<MockNearby />
	</div>
</section>
