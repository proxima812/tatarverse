---
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
import { getIntlLocale, getLocaleFromUrl, useTranslations } from "@/i18n";

/**
 * Сколько нас: три народа - сколько в мире и сколько из них в России.
 *
 * Крупно - мировая оценка Joshua Project («Population All Countries»):
 * единственный источник, который считает все три народа одним способом по
 * всем странам. Это оценка, поэтому показываем её округлённой, со знаком
 * «≈». Мелко под ней - точное число 5-й Всероссийской переписи 2020 года
 * (проведена в 2021-м, Росстат, том 5 «Национальный состав и владение
 * языками»).
 *
 * Меняешь число - меняй и ссылку под секцией. Цифра без источника с этой
 * страницы уходит: правило проекта, а не вкус.
 */

const CENSUS_YEAR = 2021;
const CENSUS_HREF = "https://rosstat.gov.ru/vpn/2020/Tom5_Nacionalnyj_sostav_i_vladenie_yazykami";
const WORLD_HREF = "https://joshuaproject.net/";

// world - Joshua Project на ноябрь 2026, russia - перепись 2021.
const STATS = [
	{ key: "tatars", world: 5_651_200, russia: 4_713_669, href: "https://joshuaproject.net/people_groups/15284" },
	{ key: "bashkirs", world: 1_640_000, russia: 1_571_879, href: "https://joshuaproject.net/people_groups/10705" },
	{ key: "crimean", world: 642_400, russia: 257_592, href: "https://joshuaproject.net/people_groups/11434" },
];

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const format = new Intl.NumberFormat(getIntlLocale(locale));
// Оценку не выдаём за точный счёт: «5,7 млн», а не «5 651 200».
const formatWorld = new Intl.NumberFormat(getIntlLocale(locale), {
	notation: "compact",
	maximumSignificantDigits: 2,
});
---

<section class="text-center" aria-labelledby="home-people-stats">
	<div class="mx-auto flex max-w-2xl flex-col items-center gap-6">
		<HomeSectionHeading id="home-people-stats" section="people" align="center" />
		<p class="leading-7 text-pretty text-muted-foreground">{t("home.people.text")}</p>
	</div>

	<dl
		class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-6"
		data-people-stats
	>
		{
			STATS.map((stat) => (
				<div class="flex flex-col gap-2">
					<dt class="text-xs uppercase tracking-wide text-muted-foreground">
						{t(`home.people.${stat.key}`)}
					</dt>
					<dd class="order-last text-sm text-muted-foreground">
						{t("home.people.inRussia", { count: format.format(stat.russia) })}
					</dd>
					<dd class="text-4xl font-bold tabular-nums tracking-tight text-accent md:text-5xl">
						<a
							href={stat.href}
							target="_blank"
							rel="noopener noreferrer"
							class="no-underline"
							title={format.format(stat.world)}
						>
							<span aria-hidden="true">≈&#8239;</span><span data-count-to={stat.world}>{formatWorld.format(stat.world)}</span>
						</a>
					</dd>
				</div>
			))
		}
	</dl>

	<p class="mt-10 text-xs text-muted-foreground">
		{t("home.people.worldNote")}{" "}
		<a
			href={WORLD_HREF}
			target="_blank"
			rel="noopener noreferrer"
			class="underline decoration-link-decoration underline-offset-2 hover:text-foreground"
		>
			Joshua Project
		</a>
		{" · "}
		{t("home.people.note", { year: CENSUS_YEAR })}{" "}
		<a
			href={CENSUS_HREF}
			target="_blank"
			rel="noopener noreferrer"
			class="underline decoration-link-decoration underline-offset-2 hover:text-foreground"
		>
			{t("home.people.source")}
		</a>
	</p>
</section>

<script>
	/**
	 * Числа набегают снизу вверх, когда секция попадает в кадр.
	 *
	 * Разметка уже содержит готовое значение - анимация только переписывает
	 * его на время. Без JS, при `prefers-reduced-motion` и в поиске виден
	 * финальный результат, а не ноль.
	 */
	const list = document.querySelector<HTMLElement>("[data-people-stats]");

	if (list && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const cells = [...list.querySelectorAll<HTMLElement>("[data-count-to]")];
		const format = new Intl.NumberFormat(document.documentElement.lang || "ru", {
			notation: "compact",
			maximumSignificantDigits: 2,
		});
		const DURATION = 1400;

		const write = (progress: number) => {
			// easeOutCubic: быстрый разгон и мягкая остановка на точном числе.
			const eased = progress >= 1 ? 1 : 1 - (1 - progress) ** 3;

			for (const cell of cells) {
				const target = Number(cell.dataset.countTo ?? 0);
				cell.textContent = format.format(Math.round(target * eased));
			}
		};

		const run = () => {
			const started = performance.now();
			write(0);

			const frame = (now: number) => {
				const progress = Math.min(1, (now - started) / DURATION);
				write(progress);

				if (progress < 1) requestAnimationFrame(frame);
			};

			requestAnimationFrame(frame);
			// Вкладка может уйти в фон и заморозить кадры на середине отсчёта:
			// возвращаемся - показываем итог, а не случайное промежуточное число.
			document.addEventListener("visibilitychange", () => {
				if (document.hidden) return;
				if (performance.now() - started >= DURATION) write(1);
			});
		};

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					observer.disconnect();
					run();
				}
			},
			{ threshold: 0.35 },
		);

		observer.observe(list);
	}
</script>
