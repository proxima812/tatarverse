---
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { catalogStats } from "@/lib/center/stats";
import { getCollection } from "astro:content";
import MockCatalog from "./showcase/MockCatalog.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const {
	count: centers,
	countries: countriesCount,
	regions: regionsCount,
} = catalogStats(await getCollection("centers"));
---

<section aria-labelledby="home-present" class="home-section">
	<div class="home-section-head">
		<HomeSectionHeading id="home-present" section="present" />
		<div class="space-y-4">
			<p
				class="leading-7 text-pretty text-muted-foreground"
				set:html={t("home.present.caption", {
					centers,
					countries: countriesCount,
					regions: regionsCount,
				})}
			/>
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.present.text1")}</p>
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.present.text2")}</p>
		</div>
	</div>

	<div class="home-section-stage">
		<MockCatalog />
	</div>
</section>
