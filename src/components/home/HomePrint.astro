---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import MockPrint from "./showcase/MockPrint.astro";

/** Каталог на бумаге: обещание раздела `/centers/print`. */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section aria-labelledby="home-print" class="home-section">
	<div class="home-section-head">
		<HomeSectionHeading id="home-print" section="print" />
		<div class="space-y-4">
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.print.text1")}</p>
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.print.text2")}</p>
			<ButtonLink
				href="/centers/print"
				labelKey="nav.print"
				label="Печать .pdf"
				icon="mdi:printer-outline"
				variant="gradient"
			/>
		</div>
	</div>

	<div class="home-section-stage">
		<MockPrint />
	</div>
</section>
