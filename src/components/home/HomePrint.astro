---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import MockPrint from "./showcase/MockPrint.astro";

/** Каталог на бумаге: обещание раздела `/centers/print`. */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section class="grid grid-cols-1 items-center gap-6 md:grid-cols-2 md:gap-12">
	<div class="space-y-6 md:order-2">
		<h2 class="text-4xl font-bold tracking-tight">{t("home.print.title")}</h2>
		<p class="leading-7 text-muted-foreground">{t("home.print.text1")}</p>
		<p class="leading-7 text-muted-foreground">{t("home.print.text2")}</p>
		<ButtonLink
			href="/centers/print"
			labelKey="nav.print"
			label="Печать .pdf"
			icon="mdi:printer-outline"
			variant="gradient"
		/>
	</div>

	<MockPrint />
</section>
