---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import MockSaved from "./showcase/MockSaved.astro";

/** Сохранённые центры: обещание раздела `/saved`. */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section aria-labelledby="home-saved" class="home-section">
	<div class="home-section-head">
		<HomeSectionHeading id="home-saved" section="saved" />
		<div class="space-y-4">
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.saved.text1")}</p>
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.saved.text2")}</p>
			<ButtonLink
				href="/saved"
				labelKey="saved.title"
				label="Сохраненные"
				icon="tabler:bookmark"
				variant="gradient"
			/>
		</div>
	</div>

	<div class="home-section-stage">
		<MockSaved />
	</div>
</section>
