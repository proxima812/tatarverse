---
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import MockSearch from "./showcase/MockSearch.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section aria-labelledby="home-search" class="home-section">
	<div class="home-section-head">
		<HomeSectionHeading id="home-search" section="search" />
		<div class="space-y-4">
			<p class="leading-7 text-pretty text-muted-foreground">
				{t("home.search.text1")}
			</p>
			<p class="leading-7 text-pretty text-muted-foreground">
				{t("home.search.text2")}
			</p>
		</div>
	</div>

	<div class="home-section-stage">
		<MockSearch />
	</div>
</section>
