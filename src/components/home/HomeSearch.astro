---
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import MockSearch from "./showcase/MockSearch.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section class="grid grid-cols-1 items-center gap-6 md:grid-cols-2 md:gap-12">
	<div class="space-y-6">
		<h2 class="text-4xl font-bold tracking-tight">
			{t("home.search.title")}
		</h2>

		<p class="leading-7 text-muted-foreground">
			{t("home.search.text1")}
		</p>

		<p class="leading-7 text-muted-foreground">
			{t("home.search.text2")}
		</p>
	</div>
	<MockSearch />
</section>
