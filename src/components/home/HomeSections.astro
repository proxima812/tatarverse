---
import HomeLinksShowcase from "@/components/home/HomeLinksShowcase.astro";
import HomeNearby from "@/components/home/HomeNearby.astro";
import HomePeopleStats from "@/components/home/HomePeopleStats.astro";
import HomePresent from "@/components/home/HomePresent.astro";
import HomePrint from "@/components/home/HomePrint.astro";
import HomeSaved from "@/components/home/HomeSaved.astro";
import HomeSearch from "@/components/home/HomeSearch.astro";

/**
 * Секции главной — bento-сетка: на lg шесть колонок, плитки разной ширины.
 * Ряды: каталог 4 + числа 2, ссылки 3 + рядом 3, сохранённые/печать/поиск по 2.
 * Ниже lg плитки идут одна под другой.
 *
 * Сетка шире контейнера страницы (5xl): выходит до 7xl, как футер, иначе
 * плитки в два-три ряда выглядят тесно. Ширина считается от вьюпорта
 * минус поля контейнера, поэтому на узких экранах ничего не вылезает.
 */

const tile = "rounded-card corner-squircle bg-surface p-6 ring-1 ring-border-muted md:p-8";
---

<div id="sections" class="relative left-1/2 grid w-[min(80rem,100vw-2.5rem)] -translate-x-1/2 grid-cols-1 gap-4 py-12 md:gap-6 md:py-20 lg:grid-cols-6">
	<div class:list={[tile, "lg:col-span-4"]}><HomePresent /></div>
	<div class:list={[tile, "lg:col-span-2"]}><HomePeopleStats /></div>
	<div class:list={[tile, "lg:col-span-3"]}><HomeLinksShowcase /></div>
	<div class:list={[tile, "lg:col-span-3"]}><HomeNearby /></div>
	<div class:list={[tile, "lg:col-span-2"]}><HomeSaved /></div>
	<div class:list={[tile, "lg:col-span-2"]}><HomePrint /></div>
	<div class:list={[tile, "lg:col-span-2"]}><HomeSearch /></div>
</div>
