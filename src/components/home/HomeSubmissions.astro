---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import MockSubmissions from "./showcase/MockSubmissions.astro";

/** «Мои заявки»: статус отправленных заявок - обещание раздела `/submissions`. */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section
	aria-labelledby="home-submissions"
	class="grid grid-cols-1 items-center gap-6 md:grid-cols-2 md:gap-12"
>
	<div class="space-y-6">
		<h2 id="home-submissions" class="text-4xl font-bold tracking-tight">
			{t("home.submissions.title")}
		</h2>
		<p class="leading-7 text-muted-foreground">{t("home.submissions.text1")}</p>
		<p class="leading-7 text-muted-foreground">{t("home.submissions.text2")}</p>
		<ButtonLink
			href="/submissions"
			labelKey="nav.mySubmissions"
			label="Мои заявки"
			icon="tabler:clipboard-list"
			variant="gradient"
		/>
	</div>

	<MockSubmissions />
</section>
