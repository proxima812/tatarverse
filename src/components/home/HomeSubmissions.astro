---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import MockSubmissions from "./showcase/MockSubmissions.astro";

/** «Мои заявки»: статус отправленных заявок - обещание раздела `/submissions`. */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section aria-labelledby="home-submissions" class="home-section">
	<div class="home-section-head">
		<HomeSectionHeading id="home-submissions" section="submissions" />
		<div class="space-y-4">
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.submissions.text1")}</p>
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.submissions.text2")}</p>
			<ButtonLink
				href="/submissions"
				labelKey="nav.mySubmissions"
				label="Мои заявки"
				icon="tabler:clipboard-list"
				variant="gradient"
			/>
		</div>
	</div>

	<div class="home-section-stage">
		<MockSubmissions />
	</div>
</section>
