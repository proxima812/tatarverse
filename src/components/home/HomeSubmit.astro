---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import MockSubmit from "./showcase/MockSubmit.astro";

/** Форма «Добавить центр»: центр, которого нет в каталоге, - через заявку модератору. */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section
	aria-labelledby="home-submit"
	class="grid grid-cols-1 items-center gap-6 md:grid-cols-2 md:gap-12"
>
	<div class="space-y-6">
		<h2 id="home-submit" class="text-4xl font-bold tracking-tight">
			{t("home.submit.title")}
		</h2>
		<p class="leading-7 text-muted-foreground">{t("home.submit.text1")}</p>
		<p class="leading-7 text-muted-foreground">{t("home.submit.text2")}</p>
		<ButtonLink
			href="/submit"
			labelKey="nav.addCenter"
			label="Добавить центр"
			icon="tabler:plus"
			variant="gradient"
		/>
	</div>

	<MockSubmit />
</section>
