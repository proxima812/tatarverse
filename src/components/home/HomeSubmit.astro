---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import MockSubmit from "./showcase/MockSubmit.astro";

/** Форма «Добавить центр»: центр, которого нет в каталоге, - через заявку модератору. */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section aria-labelledby="home-submit" class="home-section">
	<div class="home-section-head">
		<HomeSectionHeading id="home-submit" section="submit" />
		<div class="space-y-4">
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.submit.text1")}</p>
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.submit.text2")}</p>
			<ButtonLink
				href="/submit"
				labelKey="nav.addCenter"
				label="Добавить центр"
				icon="tabler:plus"
				variant="gradient"
			/>
		</div>
	</div>

	<div class="home-section-stage">
		<MockSubmit />
	</div>
</section>
