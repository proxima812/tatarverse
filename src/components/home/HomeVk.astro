---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import HomeSectionHeading from "@/components/home/HomeSectionHeading.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import MockVk from "./showcase/MockVk.astro";

/** Сообщество во ВКонтакте: тот же адрес, что в подвале. */

const VK_URL = "https://vk.ru/the_tatarverse";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section aria-labelledby="home-vk" class="home-section">
	<div class="home-section-head">
		<HomeSectionHeading id="home-vk" section="vk" />
		<div class="space-y-4">
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.vk.text1")}</p>
			<p class="leading-7 text-pretty text-muted-foreground">{t("home.vk.text2")}</p>
			<ButtonLink
				href={VK_URL}
				labelKey="home.vk.cta"
				label="Открыть ВКонтакте"
				icon="mdi:vk"
				variant="gradient"
				target="_blank"
			/>
		</div>
	</div>

	<div class="home-section-stage">
		<MockVk />
	</div>
</section>
