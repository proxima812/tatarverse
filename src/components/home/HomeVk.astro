---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import MockVk from "./showcase/MockVk.astro";

/** Сообщество во ВКонтакте: тот же адрес, что в подвале. */

const VK_URL = "https://vk.ru/the_tatarverse";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<section
	aria-labelledby="home-vk"
	class="grid grid-cols-1 items-center gap-6 md:grid-cols-2 md:gap-12"
>
	<div class="space-y-6 md:order-2">
		<h2 id="home-vk" class="text-4xl font-bold tracking-tight">
			{t("home.vk.title")}
		</h2>
		<p class="leading-7 text-muted-foreground">{t("home.vk.text1")}</p>
		<p class="leading-7 text-muted-foreground">{t("home.vk.text2")}</p>
		<ButtonLink
			href={VK_URL}
			labelKey="home.vk.cta"
			label="Открыть ВКонтакте"
			icon="mdi:vk"
			variant="gradient"
			target="_blank"
		/>
	</div>

	<MockVk />
</section>
