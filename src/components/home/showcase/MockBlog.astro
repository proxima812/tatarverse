---
import LogoMark from "@/components/layout/LogoMark.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { blogCategories, blogCategoryStyles } from "@/data/blog";
import { Icon } from "astro-icon/components";
import Cursor from "./Cursor.astro";
import ShowcaseStage from "./ShowcaseStage.astro";

/**
 * «Блог»: окно страницы `/blog` - заголовок, переключатель категорий и
 * сетка свежих публикаций с настоящими обложками и заголовками. Курсор
 * подъезжает к первой карточке, её обложка чуть приближается, как при
 * наведении на живой странице.
 *
 * Раскладка - угловой вылет, как у «Сохранённых»: окно уходит за правый
 * и нижний край, слова только у первой пары карточек.
 */
interface Props {
	entries: { title: string; format: string; cover: string }[];
}

const { entries } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<ShowcaseStage scene="blog" once label={t("home.blog.imageAlt")}>
	<div class="sc-window sc-blog-window">
		<div class="sc-site-header">
			<LogoMark size={20} class="sc-logo" />
			<span class="sc-bar sc-bar--strong" style="width: 3.2em"></span>
			<span class="sc-bar sc-bar--strong" style="width: 3.8em"></span>
			<span class="sc-bar" style="width: 2.4em"></span>
		</div>

		<div class="sc-blog-body">
			<p class="sc-blog-heading">{t("blog.heading")}</p>

			<div class="sc-blog-tabs">
				<span class="sc-blog-tab" data-active>{t("blog.allCategories")}</span>
				{
					blogCategories.map((category) => (
						<span class="sc-blog-tab">
							<span class={`sc-blog-tab-icon bg-linear-to-b ${blogCategoryStyles[category].surface}`}>
								<Icon name={blogCategoryStyles[category].icon} />
							</span>
							{t(`blog.${category}`)}
						</span>
					))
				}
			</div>

			<div class="sc-blog-grid">
				{
					entries.map((entry, index) => (
						<div class="sc-blog-card" style={`--i: ${index}`}>
							<span class="sc-blog-cover">
								<img src={entry.cover} alt="" width="1112" height="560" loading="lazy" decoding="async" />
								<span class="sc-blog-format">{t(`blog.${entry.format}`)}</span>
							</span>
							<span class="sc-blog-text">
								{index < 2 ? (
									<span class="sc-blog-title">{entry.title}</span>
								) : (
									<span class="sc-lines">
										<span class="sc-bar sc-bar--strong" style="width: 92%" />
										<span class="sc-bar sc-bar--strong" style="width: 60%" />
									</span>
								)}
								<span class="sc-blog-author">
									<LogoMark size={14} class="sc-blog-author-mark" />
									<span class="sc-bar" style="width: 4.5em" />
								</span>
							</span>
						</div>
					))
				}
			</div>
		</div>
	</div>

	<Cursor class="sc-blog-cursor" />
</ShowcaseStage>
