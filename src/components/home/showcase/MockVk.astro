---
import LogoMark from "@/components/layout/LogoMark.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { presentCards } from "@/lib/home/showcase";
import { centerAvatarMarkup } from "@/lib/center/avatar";
import { Icon } from "astro-icon/components";
import ShowcaseStage from "./ShowcaseStage.astro";

/**
 * «Мы во ВКонтакте»: окно страницы сообщества - обложка, аватар, кнопка
 * «Подписаться» и запись на стене. Картинка записи - лица центров из
 * каталога: настоящих записей на сборке нет, поэтому стена ничего не цитирует.
 *
 * Раскладка - угловой вылет, как у «Сохранённых». Играет один раз.
 */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const cards = await presentCards(locale, 3);
---

<ShowcaseStage scene="vk" once label={t("home.vk.imageAlt")}>
	<div class="sc-window sc-vk-window">
		<div class="sc-vk-cover"></div>

		<div class="sc-vk-profile">
			<span class="sc-vk-avatar"><LogoMark size={30} class="sc-vk-avatar-mark" /></span>
			<span class="sc-lines sc-vk-info">
				<span class="sc-vk-name">tatarverse</span>
				<span class="sc-bar" style="width: 9em"></span>
			</span>
			<span class="sc-vk-follow">{t("home.vk.follow")}</span>
		</div>

		<div class="sc-vk-post">
			<div class="sc-vk-post-head">
				<span class="sc-vk-post-avatar"><LogoMark size={14} class="sc-vk-avatar-mark" /></span>
				<span class="sc-lines">
					<span class="sc-vk-post-name">tatarverse</span>
					<span class="sc-bar" style="width: 3.5em"></span>
				</span>
			</div>
			<span class="sc-bar" style="width: 92%"></span>
			<span class="sc-bar" style="width: 64%"></span>
			<div class="sc-vk-media">
				{
					cards.map((card) => (
						<span class="sc-vk-media-tile">
							<center-avatar class="center-avatar sc-vk-media-avatar" set:html={centerAvatarMarkup(card.id)} />
							<span class="sc-vk-media-flag">{card.flag}</span>
						</span>
					))
				}
			</div>
			<div class="sc-vk-actions">
				<span class="sc-vk-action"><Icon name="mdi:heart-outline" /><span class="sc-bar" style="width: 1.4em"></span></span>
				<span class="sc-vk-action"><Icon name="mdi:comment-outline" /><span class="sc-bar" style="width: 1em"></span></span>
				<span class="sc-vk-action"><Icon name="mdi:share-outline" /><span class="sc-bar" style="width: 1em"></span></span>
			</div>
		</div>
	</div>
</ShowcaseStage>

<script>
	import "@/lib/client/centerAvatars";
</script>
