---
import LogoMark from "@/components/layout/LogoMark.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { presentCards } from "@/lib/home/showcase";
import { centerAvatarMarkup } from "@/lib/center/avatar";
import { Icon } from "astro-icon/components";
import ShowcaseStage from "./ShowcaseStage.astro";

/**
 * «Мы во ВКонтакте»: страница сообщества, как её рисует сам ВКонтакте, -
 * белые блоки на сером фоне. Сверху шапка: обложка, круглый аватар
 * поверх неё, название, «Подписаться» и «…». Ниже запись на стене:
 * автор, текст, фото и счётчики (нравится, комментарии, репост, просмотры).
 *
 * Фото записи - лица центров из каталога: настоящих записей на сборке
 * нет, поэтому стена ничего не цитирует. Раскладка - угловой вылет,
 * как у «Сохранённых». Играет один раз.
 */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const cards = await presentCards(locale, 3);
---

<ShowcaseStage scene="vk" once label={t("home.vk.imageAlt")}>
	<div class="sc-window sc-vk-window">
		<div class="sc-vk-block sc-vk-head">
			<div class="sc-vk-cover"></div>
			<div class="sc-vk-profile">
				<span class="sc-vk-avatar"><LogoMark size={30} class="sc-vk-avatar-mark" /></span>
				<span class="sc-vk-info">
					<span class="sc-vk-name">tatarverse</span>
					<span class="sc-vk-kind">{t("home.vk.kind")}</span>
				</span>
				<span class="sc-vk-follow">{t("home.vk.follow")}</span>
				<span class="sc-vk-more"><Icon name="tabler:dots" /></span>
			</div>
		</div>

		<div class="sc-vk-block sc-vk-post">
			<div class="sc-vk-post-head">
				<span class="sc-vk-post-avatar"><LogoMark size={14} class="sc-vk-avatar-mark" /></span>
				<span class="sc-lines">
					<span class="sc-vk-post-name">tatarverse</span>
					<span class="sc-bar" style="width: 4em"></span>
				</span>
				<Icon name="tabler:dots" class="sc-vk-post-menu" />
			</div>
			<span class="sc-bar" style="width: 88%"></span>
			<div class="sc-vk-media">
				{
					cards.map((card, i) => (
						<span class="sc-vk-media-tile" style={`--i: ${i}`}>
							<center-avatar class="center-avatar sc-vk-media-avatar" set:html={centerAvatarMarkup(card.id)} />
						</span>
					))
				}
			</div>
			<div class="sc-vk-actions">
				<span class="sc-vk-action sc-vk-like"><Icon name="tabler:heart-filled" /><span class="sc-bar" style="width: 1.2em"></span></span>
				<span class="sc-vk-action"><Icon name="tabler:message-circle" /><span class="sc-bar" style="width: 0.8em"></span></span>
				<span class="sc-vk-action"><Icon name="tabler:share-3" /><span class="sc-bar" style="width: 0.8em"></span></span>
				<span class="sc-vk-views"><Icon name="tabler:eye" /><span class="sc-bar" style="width: 1.6em"></span></span>
			</div>
		</div>
	</div>
</ShowcaseStage>

<script>
	import "@/lib/client/centerAvatars";
</script>
