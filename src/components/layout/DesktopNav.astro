---
import { isActiveRoute } from "@/lib/site/navigation";
import { links } from "@/data/links";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";

const currentLocale = getLocaleFromUrl(Astro.url);
const t = useTranslations(currentLocale);

const materialHrefs = new Set(["/translations", "/sources", "/policy"]);
// Заявки - в выпадающее «Прочее»: в верхней строке им места нет.
const submissionHrefs = new Set(["/submit", "/submissions"]);

const topLevelLinks = links.filter(
	(item) => !materialHrefs.has(item.href) && !submissionHrefs.has(item.href),
);
const materialLinks = links.filter((item) => materialHrefs.has(item.href));

const printLink = {
	href: "/centers/print",
	label: "Печать .pdf",
	labelKey: "nav.print",
	target: undefined,
};
const otherDropdownItems = [...links.filter((item) => submissionHrefs.has(item.href)), printLink];

const isActivePath = (href: string) => isActiveRoute(Astro.url.pathname, href);

const dropdowns = [
	{ id: "materials", labelKey: "menu.materials", items: materialLinks },
	{ id: "other", labelKey: "menu.other", items: otherDropdownItems },
].filter((dropdown) => dropdown.items.length > 0);

// Как у heroui.com: ссылки - просто текст, приглушённый до наведения;
// текущий раздел - в полный цвет.
const linkClass =
	"inline-flex h-9 cursor-pointer items-center gap-1 text-sm font-medium text-muted-foreground no-underline transition-colors hover:text-foreground aria-[current]:text-foreground";

const itemClass =
	"flex items-center gap-2 rounded-control px-3 py-2 text-sm font-medium text-subtle-foreground no-underline transition-colors hover:bg-muted hover:text-foreground aria-[current]:bg-muted aria-[current]:text-foreground ";
---

<nav class="hidden items-center gap-5 lg:flex" aria-label={t("nav.primary")}>
	{
		topLevelLinks.map((item) => (
			<a
				href={localizePath(currentLocale, item.href)}
				target={item.target}
				class={linkClass}
				aria-current={isActivePath(item.href) ? "page" : undefined}
			>
				{t(item.labelKey, undefined, item.label)}
			</a>
		))
	}

	{
		dropdowns.map((dropdown) => {
			const isActive = dropdown.items.some((item) => isActivePath(item.href));

			return (
				<div class="relative" data-dropdown-menu>
					<button
						type="button"
						data-dropdown-trigger
						class={`${linkClass} ${isActive ? "text-foreground" : ""}`}
						aria-haspopup="true"
						aria-expanded="false"
						aria-controls={`${dropdown.id}-dropdown`}
					>
						<span>{t(dropdown.labelKey)}</span>
						<svg
							aria-hidden="true"
							viewBox="0 0 16 16"
							class="size-3.5 shrink-0 transition-transform duration-200"
							data-dropdown-chevron
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
						>
							<path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>

					<div
						id={`${dropdown.id}-dropdown`}
						data-dropdown-panel
						class="absolute left-0 top-full z-[90] mt-2 min-w-48 rounded-control border border-border-muted bg-surface p-1 overlay-lift"
						hidden
					>
						{dropdown.items.map((item) => (
							<a
								href={localizePath(currentLocale, item.href)}
								target={item.target}
								class={itemClass}
								aria-current={isActivePath(item.href) ? "page" : undefined}
							>
								{t(item.labelKey, undefined, item.label)}
							</a>
						))}
					</div>
				</div>
			);
		})
	}
</nav>

<script>
	document.querySelectorAll<HTMLElement>("[data-dropdown-menu]").forEach((root) => {
		const trigger = root.querySelector<HTMLButtonElement>("[data-dropdown-trigger]");
		const panel = root.querySelector<HTMLElement>("[data-dropdown-panel]");
		const chevron = root.querySelector<HTMLElement>("[data-dropdown-chevron]");

		if (!trigger || !panel) return;

		const setOpen = (isOpen: boolean) => {
			panel.hidden = !isOpen;
			trigger.setAttribute("aria-expanded", String(isOpen));
			chevron?.classList.toggle("rotate-180", isOpen);
		};

		trigger.addEventListener("click", () => {
			setOpen(Boolean(panel.hidden));
		});

		document.addEventListener("click", (event) => {
			if (event.target instanceof Node && !root.contains(event.target)) {
				setOpen(false);
			}
		});

		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape" || panel.hidden) return;

			setOpen(false);
			trigger.focus();
		});
	});
</script>
