---
import { pressMentions } from "@/data/press";
import { updatedAt } from "@/data/siteUpdated";
import { externalLinkProps } from "@/lib/site/links";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import { Icon } from "astro-icon/components";
import Container from "./Container.astro";
import LogoMark from "./LogoMark.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const policyHref = localizePath(locale, "/policy");
const updatedAtLabel = new Intl.DateTimeFormat(locale, {
	day: "numeric",
	month: "long",
	year: "numeric",
	hour: "2-digit",
	minute: "2-digit",
	hour12: false,
	timeZone: "Asia/Almaty",
}).format(new Date(updatedAt));

const baseStyle =
	"text-[var(--footer-fg-muted)] transition-colors hover:text-[var(--footer-fg)]";

type FooterLink = {
	href: string;
	label: string;
	icon?: string;
	nowrap?: boolean;
	props?: Record<string, string>;
};

type FooterSection = {
	id: string;
	title: string;
	links: FooterLink[];
};

const externalProps = externalLinkProps;

const social = (href: string, network: string, icon: string): FooterLink => ({
	href,
	label: t("footer.social.on", { network }),
	icon,
	props: externalProps,
});

const footerSections: FooterSection[] = [
	{
		id: "navigation",
		title: t("footer.navigation.title"),
		links: [
			{ href: localizePath(locale, "/centers"), label: t("nav.viewCenters") },
			{ href: localizePath(locale, "/stats"), label: t("nav.stats") },
			{ href: localizePath(locale, "/nearby"), label: t("nav.nearby") },
			{ href: localizePath(locale, "/saved"), label: t("saved.title") },
			{
				href: localizePath(locale, "/centers/print"),
				label: t("nav.print"),
				icon: "mdi:printer-outline",
				nowrap: true,
			},
			{ href: "/api", label: "API" },
		],
	},
	{
		id: "developers",
		title: t("footer.developers.title"),
		links: [
			{ href: "/api", label: t("footer.developers.docs"), icon: "mdi:api" },
			{ href: "/openapi.json", label: "OpenAPI (JSON)", icon: "mdi:code-json" },
		],
	},
	{
		id: "materials",
		title: t("footer.materials.title"),
		links: [
			{ href: localizePath(locale, "/translations"), label: t("nav.translations") },
			{ href: localizePath(locale, "/sources"), label: t("nav.sources") },
			{ href: policyHref, label: t("footer.privacy") },
		],
	},
	{
		id: "about",
		title: t("footer.about.title"),
		links: [
			{
				href: "https://vc.ru/life/3102323-poisk-tatarskikh-tsentrov-katalog-organizatsiy",
				label: t("footer.about.story"),
				props: externalProps,
			},
			...pressMentions.map((mention) => ({
				href: mention.href,
				label: t("footer.about.press", { outlet: mention.outlet }),
				props: externalProps,
			})),
		],
	},
	{
		id: "social",
		title: t("footer.social.title"),
		links: [
			social("https://t.me/the_tatarverse", "Telegram", "mdi:telegram"),
			social("https://www.instagram.com/the_tatarverse/", "Instagram", "mdi:instagram"),
			social("https://vk.ru/the_tatarverse", t("footer.social.vk"), "mdi:vk"),
			social("https://www.threads.com/@the_tatarverse", "Threads", "tabler:brand-threads"),
		],
	},
	{
		id: "collab",
		title: t("footer.collab.title"),
		links: [
			{
				href: "mailto:kamil.mirikhan@gmail.com",
				label: t("footer.collab.email"),
				icon: "mdi:email-outline",
				nowrap: true,
			},
		],
	},
];

const sectionById = new Map(footerSections.map((section) => [section.id, section]));
const footerColumns: FooterSection[][] = [
	["navigation", "developers"],
	["materials", "about"],
	["social", "collab"],
].map((ids) => ids.map((id) => sectionById.get(id)).filter((s): s is FooterSection => !!s));
---

<footer
	class="site-footer rounded-t-[30px] md:rounded-t-[60px] mt-auto pt-15 pb-10 text-sm sm:text-xs"
>
	<Container container class="max-w-7xl">
		<div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,2.5fr)]">
			<div class="space-y-3">
				<a
					href={localizePath(locale, "/")}
					class="inline-flex items-center gap-1.5 text-[var(--footer-fg)] no-underline"
				>
					<LogoMark size={22} />
					<span class="font-bold">tatarverse</span>
				</a>
				<p class="max-w-md leading-6">{t("footer.description")}</p>
			</div>

			<nav aria-label={t("footer.links")} class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
				{
					footerColumns.map((column) => (
						<div class="space-y-8">
							{column.map((section) => (
								<section aria-labelledby={`footer-${section.id}`}>
									<p
										id={`footer-${section.id}`}
										class="mb-3 text-base font-semibold text-[var(--footer-fg)]"
									>
										{section.title}
									</p>
									<ul class="space-y-2 text-sm">
										{section.links.map((link) => (
											<li>
												<a
													href={link.href}
													class={`inline-flex min-h-6 min-w-0 max-w-full items-start gap-1.5 ${baseStyle}`}
													{...link.props}
												>
													{link.icon && (
														<Icon
															name={link.icon}
															class="size-4 shrink-0 translate-y-0.5"
															aria-hidden="true"
														/>
													)}
													<span
														class:list={[
															"min-w-0",
															link.nowrap ? "whitespace-nowrap" : "wrap-anywhere",
														]}
													>
														{link.label}
													</span>
												</a>
											</li>
										))}
									</ul>
								</section>
							))}
						</div>
					))
				}
			</nav>
		</div>

		<div
			class="mt-10 flex flex-col gap-2 border-t pt-6 sm:flex-row sm:items-center sm:justify-between"
			style="border-color: var(--footer-border)"
		>
			<p>
				&copy; tatarverse.cc {new Date().getFullYear()} · {t("footer.legalNote")}
			</p>
			<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">

				<p class="text-sm text-[var(--footer-fg-muted)]">
					{t("footer.updated", { date: updatedAtLabel })}
				</p>
			</div>
		</div>
	</Container>
</footer>

