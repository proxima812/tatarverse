---
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import AppearanceMenu from "./AppearanceMenu.astro";
import DesktopNav from "./DesktopNav.astro";
import LanguageToggle from "./LanguageToggle.astro";
import Logotype from "./Logotype.astro";
import Menu from "./Menu.astro";
import SavedLink from "./SavedLink.astro";

/**
 * Шапка по образцу heroui.com: во всю ширину и без подложки. Четыре группы
 * с равными промежутками: марка, ссылки, настройки (закладки, палитра,
 * язык) и отдельно главная кнопка.
 * Когда страница уехала вверх, строка сжимается в плавающую «пилюлю» с
 * размытием, а под ней проступает затемнение из цвета фона (`header.css`).
 */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<header
	data-site-header
	class="site-header sticky top-0 z-[88] isolate flex w-full justify-center px-6 py-2 max-md:bg-background max-md:px-4 max-md:py-1"
>
	<div aria-hidden="true" class="site-header-fade pointer-events-none absolute inset-x-0 top-0 -z-10 max-md:hidden"></div>
	<div class="site-header-bar flex w-full max-w-5xl items-center justify-between gap-4 max-md:h-12">
		<div class="flex shrink-0 items-center">
			<Logotype />
		</div>

		<DesktopNav />

		<div class="hidden h-9 shrink-0 items-center gap-0.5 lg:inline-flex">
			<SavedLink bare />
			<AppearanceMenu bare />
			<LanguageToggle bare />
		</div>

		<div class="flex h-9 shrink-0 items-center gap-2">
			<a
				href={localizePath(locale, "/centers")}
				class="inline-flex h-9 shrink-0 items-center rounded-full bg-accent px-4 text-sm font-medium text-accent-foreground no-underline transition-[filter] hover:brightness-110 max-md:px-3"
			>
				{t("nav.cta")}
			</a>

			<Menu />
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>("[data-site-header]");

	if (header) {
		const sync = () => header.toggleAttribute("data-scrolled", scrollY > 8);
		sync();
		addEventListener("scroll", sync, { passive: true });
	}
</script>
