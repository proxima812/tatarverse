---
import SocialButton from "../social/SocialButton.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { cn } from "@/lib/cn";
import { Icon } from "astro-icon/components";

interface Props {
	href?: string;
	class?: string;
}

type LinkView = {
	label: string;
	ariaLabel: string;
	ariaKey: string;
	ariaValue: string;
	icon: string;
	isExternal: boolean;
	social: string | null;
};

const { href = "", class: className } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const slotHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const rawText = slotHtml
	.replace(/<[^>]*>/g, "")
	.replace(/&amp;/g, "&")
	.replace(/&lt;/g, "<")
	.replace(/&gt;/g, ">")
	.replace(/&quot;/g, '"')
	.replace(/&#39;/g, "'")
	.trim();

const socialByHost: Record<string, string> = {
	"t.me": "telegram",
	"telegram.me": "telegram",
	"telegram.org": "telegram",
	"github.com": "github",
	"instagram.com": "instagram",
	"youtube.com": "youtube",
	"youtu.be": "youtube",
	"vk.com": "vk",
	"vkontakte.ru": "vk",
	"wa.me": "whatsapp",
	"whatsapp.com": "whatsapp",
	"chat.whatsapp.com": "whatsapp",
	"linkedin.com": "linkedin",
	"x.com": "x",
	"twitter.com": "x",
	"discord.com": "discord",
	"discord.gg": "discord",
	"tiktok.com": "tiktok",
	"dribbble.com": "dribbble",
	"behance.net": "behance",
	"facebook.com": "facebook",
};

/*
 * Ссылка - обычный строчный элемент, а не inline-flex: длинная подпись
 * переносится как текст, а иконка остаётся в начале первой строки.
 * С flex-wrap подпись целиком уезжала на новую строку под иконку.
 * Подчёркнут только текст - пунктиром, при наведении сплошной линией.
 */
const baseLinkClass = "group inline text-link transition-colors wrap-anywhere";
const labelClass =
	"inline underline decoration-dotted decoration-link-decoration decoration-2 underline-offset-4 wrap-anywhere group-hover:decoration-solid group-hover:decoration-link";
const iconClass = "mr-1.5 inline-block size-4 shrink-0 align-[-0.2em] text-current opacity-70";

const defaultView = (value: string): LinkView => ({
	label: rawText || value,
	ariaLabel: `Open link: ${value}`,
	ariaKey: "link.open",
	ariaValue: value,
	icon: "mdi:link",
	isExternal: false,
	social: null,
});

const emailView = (value: string): LinkView => ({
	label: rawText || value.replace(/^mailto:/, ""),
	ariaLabel: `Send email: ${rawText || value.replace(/^mailto:/, "")}`,
	ariaKey: "link.mail",
	ariaValue: rawText || value.replace(/^mailto:/, ""),
	icon: "mdi:email-outline",
	isExternal: false,
	social: null,
});

const phoneView = (value: string): LinkView => ({
	label: rawText || value.replace(/^(tel:|sms:)/, ""),
	ariaLabel: value.startsWith("sms:")
		? `Send message: ${rawText || value.replace(/^sms:/, "")}`
		: `Call: ${rawText || value.replace(/^tel:/, "")}`,
	ariaKey: value.startsWith("sms:") ? "link.sms" : "link.phone",
	ariaValue: rawText || value.replace(/^(tel:|sms:)/, ""),
	icon: value.startsWith("sms:") ? "mdi:message-outline" : "mdi:phone-outline",
	isExternal: false,
	social: null,
});

const siteView = (value: string): LinkView => {
	try {
		const url = new URL(value);
		const hostname = url.hostname.replace(/^www\./, "");
		return {
			label: rawText || hostname,
			ariaLabel: `Open website: ${hostname}`,
			ariaKey: "link.site",
			ariaValue: hostname,
			icon: "mdi:open-in-new",
			isExternal:
				["http:", "https:"].includes(url.protocol) && url.origin !== Astro.site?.origin,
			social: socialByHost[hostname] ?? null,
		};
	} catch {
		const cleaned = value
			.replace(/^https?:\/\//, "")
			.replace(/^www\./, "")
			.replace(/\/$/, "")
			.split("/")[0];

		return defaultView(cleaned || value);
	}
};

const view = href.startsWith("mailto:")
	? emailView(href)
	: href.startsWith("tel:") || href.startsWith("sms:")
		? phoneView(href)
		: siteView(href);

const externalAttrs = view.isExternal
	? { target: "_blank", rel: "noopener noreferrer nofollow" }
	: {};
const ariaLabel = t(view.ariaKey, { value: view.ariaValue }, view.ariaLabel);
---

{
	view.social ? (
		<SocialButton
			href={href}
			social={view.social}
			title={view.label}
			ariaLabel={ariaLabel}
			iconStyle="mono"
			variant="link"
			iconSize={16}
			class={cn(baseLinkClass, className)}
			labelClass={cn(labelClass, "leading-normal")}
			iconClass={iconClass}
			{...externalAttrs}
		/>
	) : (
		<a
			href={href}
			class={cn(baseLinkClass, className)}
			aria-label={ariaLabel}
			{...externalAttrs}
		>
			<Icon name={view.icon} class={iconClass} />
			<span class={labelClass}>{view.label}</span>
		</a>
	)
}
