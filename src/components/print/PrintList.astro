---
import type { PrintCountry } from "@/lib/center/print";

interface Props {
	countries: PrintCountry[];
}

const { countries } = Astro.props as Props;
---

<main class="mt-10 print:mt-6">
	{
		countries.map((group) => (
			<section data-print-group={group.country} class="mt-10 first:mt-0 print:mt-6">
				<h2 class="text-sm font-semibold tracking-wide uppercase text-muted-foreground print:text-xs">
					{group.label} — {group.entries.length}
				</h2>
				<ol class="mt-4 divide-y divide-border-muted border-t border-border-muted">
					{group.entries.map((entry, index) => (
						<li class="grid grid-cols-[2.5rem_1fr] gap-x-3 py-4 print:py-2.5">
							<span class="text-sm tabular-nums text-subtle-foreground print:text-xs">
								{index + 1}
							</span>
							<div class="min-w-0">
								<p class="text-base font-semibold print:text-sm">{entry.title}</p>
								{entry.place && (
									<p class="mt-1 text-sm print:text-xs">{entry.place}</p>
								)}
								{entry.kind && (
									<p class="mt-0.5 text-sm text-muted-foreground print:text-xs">{entry.kind}</p>
								)}
								<p class="mt-1.5 text-sm break-all text-subtle-foreground print:text-xs">
									{entry.source && (
										<>
											{entry.source}
											<span aria-hidden="true"> · </span>
										</>
									)}
									{entry.href}
								</p>
							</div>
						</li>
					))}
				</ol>
			</section>
		))
	}
</main>
