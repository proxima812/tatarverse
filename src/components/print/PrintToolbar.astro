---
import Button from "@/components/ui/Button.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { buttonClass } from "@/lib/button";
import type { PrintCountry } from "@/lib/center/print";

/**
 * Экранная часть `/centers/print`: выбор стран и запуск печати. На бумагу не
 * уходит (`print:hidden`), поэтому здесь живут обычные кнопки проекта.
 */
interface Props {
	countries: PrintCountry[];
	total: number;
	catalogHref: string;
}

const { countries, total, catalogHref } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const filterClass = buttonClass({
	variant: "outline",
	size: "xs",
	extra:
		"cursor-pointer data-[active]:bg-primary data-[active]:text-primary-foreground data-[active]:ring-primary",
});
---

<div data-print-toolbar class="mt-8 space-y-4 print:hidden">
	<p class="text-sm text-muted-foreground">{t("print.hint")}</p>

	<div
		class="flex flex-wrap gap-1.5"
		role="group"
		aria-label={t("print.countries.aria")}
		data-print-countries
	>
		<button type="button" data-print-all data-active="" aria-pressed="true" class={filterClass}>
			{t("print.allCountries")} ({total})
		</button>
		{
			countries.map((group) => (
				<button
					type="button"
					data-print-country={group.country}
					aria-pressed="false"
					class={filterClass}
				>
					{group.label} ({group.entries.length})
				</button>
			))
		}
	</div>

	<div class="flex flex-wrap items-center gap-1.5">
		<Button
			data-print-button
			labelKey="print.open"
			label="Открыть окно печати"
			icon="mdi:printer-outline"
			variant="gradient"
		/>
		<ButtonLink
			href={catalogHref}
			labelKey="print.back"
			label="Вернуться к каталогу"
			icon="mdi:arrow-left"
			variant="outline"
		/>
		<span
			data-print-summary
			data-template={t("print.ready", { count: "{count}" })}
			aria-live="polite"
			class="text-sm text-muted-foreground"
		>
			{t("print.ready", { count: total })}
		</span>
	</div>
</div>

<script>
	import { initPrintCatalog } from "@/lib/scripts/printCatalog";

	initPrintCatalog();
</script>
