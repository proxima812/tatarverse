---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { config } from "@/config";
import { countryFlagsByRu, getCountryLabel } from "@/data/worldCountries";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import { createCenterRouteIdMap, getCenterPath } from "@/lib/center/centers";
import { getCenterCompleteness, type CenterGap } from "@/lib/center/completeness";
import { getCollection } from "astro:content";

/**
 * Полнота каталога: сколько карточек заполнено, чего чаще не хватает и
 * список тех, кому нужна помощь, по странам. Те же правила, что у статуса
 * на странице центра (getCenterCompleteness), - числа считаются, а не пишутся.
 */

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const centers = await getCollection("centers");
const routeIds = createCenterRouteIdMap(centers);
const englishTitles =
	locale === "en"
		? new Map((await getCollection("centersEn")).map((entry) => [entry.id, entry.data.title]))
		: null;

const GAPS: CenterGap[] = ["contacts", "about", "city", "sources"];
const gapCounts = new Map<CenterGap, number>(GAPS.map((gap) => [gap, 0]));

type Row = { href: string; title: string; gaps: CenterGap[] };
const byCountry = new Map<string, Row[]>();
let complete = 0;

for (const entry of centers) {
	const { complete: isComplete, gaps } = getCenterCompleteness(entry);
	if (isComplete) {
		complete += 1;
		continue;
	}
	for (const gap of gaps) gapCounts.set(gap, (gapCounts.get(gap) ?? 0) + 1);

	const country = entry.data.location?.country ?? "";
	const rows = byCountry.get(country) ?? [];
	rows.push({
		href: localizePath(locale, getCenterPath(routeIds.get(entry.id) ?? entry.id)),
		title: englishTitles?.get(entry.id) ?? entry.data.title,
		gaps,
	});
	byCountry.set(country, rows);
}

const incomplete = centers.length - complete;
const countries = [...byCountry.entries()]
	.map(([country, rows]) => ({
		country,
		label: country ? getCountryLabel(country, locale) : t("stats.completeness.online"),
		flag: country ? (countryFlagsByRu[country] ?? "") : "",
		rows: rows.sort((a, b) => a.title.localeCompare(b.title, locale)),
	}))
	.sort((a, b) => b.rows.length - a.rows.length || a.label.localeCompare(b.label, locale));
---

<section class="min-w-0">
	<h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
		{t("stats.completeness.title")}
	</h2>
	<p class="mt-2 max-w-[68ch] text-sm leading-6 text-muted-foreground">
		{t("stats.completeness.hint", { complete, total: centers.length, incomplete })}
	</p>

	<dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3 border-y border-border py-4 text-sm sm:grid-cols-4">
		{
			GAPS.map((gap) => (
				<div>
					<dt class="text-xs text-subtle-foreground">{t(`stats.completeness.gap.${gap}`)}</dt>
					<dd class="mt-0.5 text-lg font-semibold tabular-nums text-foreground">{gapCounts.get(gap)}</dd>
				</div>
			))
		}
	</dl>

	<details class="mt-6">
		<summary class="cursor-pointer text-sm font-medium text-foreground underline decoration-current/40 underline-offset-4">
			{t("stats.completeness.list", { count: incomplete })}
		</summary>
		<div class="mt-6 space-y-8">
			{
				countries.map((group) => (
					<section>
						<h3 class="flex items-baseline justify-between gap-4 border-b border-border pb-2 text-base font-bold tracking-tight text-foreground">
							<span>
								{group.flag && <span aria-hidden="true">{group.flag} </span>}
								{group.label}
							</span>
							<span class="shrink-0 text-xs font-medium text-muted-foreground">{group.rows.length}</span>
						</h3>
						<ul class="divide-y divide-border-muted">
							{group.rows.map((row) => (
								<li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 py-2 text-sm">
									<a
										href={row.href}
										class="min-w-0 font-medium text-foreground underline-offset-4 hover:underline hover:decoration-current/40"
									>
										{row.title}
									</a>
									<span class="text-xs text-subtle-foreground">
										{row.gaps.map((gap) => t(`stats.completeness.short.${gap}`)).join(" · ")}
									</span>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</details>

	<div class="mt-8 flex flex-wrap items-center gap-3 border-t border-border pt-6">
		<p class="text-sm leading-6 text-muted-foreground">{t("detail.status.help")}</p>
		<ButtonLink
			href={config.feedbackUrl}
			target="_blank"
			variant="outline"
			size="xs"
			icon="mdi:telegram"
			label={t("detail.status.cta")}
		/>
	</div>
</section>
