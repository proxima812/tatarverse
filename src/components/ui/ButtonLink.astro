---
import { getLocaleFromUrl, getLocalePathname, localizePath, useTranslations } from "@/i18n";
import { buttonClass, type ButtonSize, type ButtonVariant } from "@/lib/button";
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
	variant?: ButtonVariant;
	size?: ButtonSize;
	label?: string;
	labelKey?: string;
	href?: string;
	icon?: string;
	badge?: number;
}

const {
	class: className,
	variant = "default",
	size = "default",
	label = "label",
	labelKey,
	href = "#",
	icon,
	badge,
	target,
	rel: relProp,
	...props
} = Astro.props as Props;

const isDisabled = variant === "disabled";
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const localizedHref = href ? localizePath(locale, href) : href;
const isActive =
	variant === "ghost" &&
	!!localizedHref &&
	getLocalePathname(Astro.url.pathname) === getLocalePathname(localizedHref);
const classes = buttonClass({
	variant,
	size,
	className,
	extra: [
		isActive && "text-foreground",
		isDisabled && "pointer-events-none cursor-not-allowed opacity-50 hover:bg-transparent",
	],
});
const text = labelKey ? t(labelKey, undefined, label) : label;
const soonText = t("nav.soon", undefined, "soon...");
const rel = target === "_blank" && !relProp ? "noopener noreferrer" : relProp;
---

<a
	href={isDisabled ? undefined : localizedHref}
	aria-disabled={isDisabled || undefined}
	tabindex={isDisabled ? -1 : undefined}
	class={classes}
	target={target}
	rel={rel}
	{...props}
>
	{icon ? <Icon name={icon} class="w-4 h-4" aria-hidden="true" /> : <slot name="icon" />}
	<span>{text}</span>
	{badge !== undefined && <span class="text-xs opacity-60 tabular-nums">({badge})</span>}
	{
		variant === "disabled" && (
			<>
				{" "}
				<i class="text-xs opacity-40">{soonText}</i>
			</>
		)
	}
</a>
