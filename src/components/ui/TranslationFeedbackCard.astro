---
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import { Icon } from "astro-icon/components";

/** Просьба поправить карточку или перевод - ведёт в форму правки центра. */
interface Props {
	/** Код центра tbk-N. */
	code: string;
}

const { code } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const editHref = localizePath(locale, `/submit/edit?code=${encodeURIComponent(code)}`);
---

<section class="flex gap-1.5 justify-between flex-wrap">
	<div
		id="errors"
		class="max-w-fit flex gap-1.5 sm:items-center items-start text-sm font-medium bg-destructive/10 text-destructive px-3 py-1.5 rounded-micro"
	>
		<Icon name="mdi:warning" class="shrink-0 inline" />
		<span>{t("feedback.text")}</span>
	</div>
	<a
		href={editHref}
		class="max-w-fit hover:bg-subtle hover:text-foreground transition-colors ease-linear ring-1 ring-border-muted flex gap-1.5 items-center text-sm font-medium bg-surface text-primary px-3 py-1.5 rounded-control shadow-2xs"
	>
		<Icon name="tabler:pencil" />
		<span>{t("feedback.link")}</span>
	</a>
</section>
