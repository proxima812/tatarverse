---
import MDX from "@/layouts/MDX.astro";
import * as en from "@/data/pages_i18n/en/sources.mdx";
import * as tt from "@/data/pages_i18n/tt/sources.mdx";
export { secondaryLocalePaths as getStaticPaths } from "@/i18n/routes";

const { Content, file, frontmatter } = Astro.params.locale === "tt" ? tt : en;
---

<MDX frontmatter={frontmatter} file={file}>
	<Content />
</MDX>
