---
import Layout from "@/layouts/Layout.astro";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import { blogCategories, blogCategoryIcons, blogFormats } from "@/data/blog";
import { getBlogEntries } from "@/lib/blog";
import { Icon } from "astro-icon/components";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const entries = await getBlogEntries(locale);
const dateFormat = new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric" });
const filterClass = "cursor-pointer rounded-full px-4 py-2 text-sm text-subtle-foreground transition-colors hover:bg-muted aria-pressed:bg-foreground aria-pressed:text-background focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none";
---

<Layout title={t("nav.blog")} description={t("blog.description")}>
	<main data-blog class="py-4 sm:py-8">
		<header class="max-w-2xl">
			<h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-6xl">{t("blog.heading")}</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-subtle-foreground sm:text-lg">{t("blog.description")}</p>
		</header>

		<section class="mt-10" aria-labelledby="blog-categories">
			<h2 id="blog-categories" class="sr-only">{t("blog.categories")}</h2>
			<div class="flex flex-wrap gap-2">
				{blogCategories.map((category) => (
					<button type="button" data-blog-category={category} aria-pressed="false" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-border-muted px-4 py-2 text-sm text-foreground transition-colors hover:bg-muted aria-pressed:border-foreground aria-pressed:bg-foreground aria-pressed:text-background focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none">
						<Icon name={blogCategoryIcons[category]} class="size-4 shrink-0" aria-hidden="true" />
						{t(`blog.${category}`)}
					</button>
				))}
			</div>
		</section>

		<div class="mt-10 border-b border-border-muted pb-5 sm:mt-14">
			<div class="flex flex-wrap gap-1" role="group" aria-label={t("blog.formats")}>
				<button type="button" data-blog-format="all" aria-pressed="true" class={filterClass}>{t("blog.all")}</button>
				{blogFormats.map((format) => <button type="button" data-blog-format={format} aria-pressed="false" class={filterClass}>{t(`blog.${format}`)}</button>)}
			</div>
		</div>

		<section class="mt-8" aria-labelledby="blog-latest">
			<div class="mb-6 flex items-center justify-between gap-4">
				<h2 id="blog-latest" class="text-xl font-semibold tracking-tight">{t("blog.latest")}</h2>
				<p data-blog-count data-template={t("blog.count")} class="text-xs text-muted-foreground" role="status" aria-live="polite">{t("blog.count", { count: entries.length })}</p>
			</div>
			<div class="grid gap-x-8 gap-y-10 sm:grid-cols-2">
				{entries.map((entry) => (
					<article data-blog-entry data-category={entry.data.category} data-format={entry.data.format}>
						<a href={localizePath(locale, `/blog/${entry.id}/`)} class="group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
							{entry.data.cover && <img src={entry.data.cover} alt="" width="800" height="500" loading="lazy" class="mb-5 aspect-8/5 w-full rounded-2xl object-cover" />}
							<div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
								<span class="inline-flex items-center gap-1.5 rounded-md bg-muted px-2 py-1 font-medium text-foreground"><Icon name={entry.data.format === "guide" ? "mdi:compass-outline" : entry.data.format === "article" ? "mdi:text-box-outline" : "mdi:note-text-outline"} class="size-3.5" aria-hidden="true" />{t(`blog.${entry.data.format}`)}</span>
								<span>{t(`blog.${entry.data.category}`)}</span>
							</div>
							<h3 class="text-xl font-semibold tracking-tight text-foreground group-hover:underline decoration-accent underline-offset-4">{entry.data.title}</h3>
							<p class="mt-3 text-sm leading-6 text-subtle-foreground">{entry.data.description}</p>
							<p class="mt-4 text-xs text-muted-foreground">{entry.data.author} · <time datetime={entry.data.pubDate.toISOString()}>{dateFormat.format(entry.data.pubDate)}</time></p>
						</a>
					</article>
				))}
			</div>
			<div data-blog-empty hidden={entries.length > 0} class="rounded-2xl border border-dashed border-border-muted px-6 py-16 text-center">
				<Icon name="mdi:book-open-page-variant-outline" class="mx-auto mb-5 size-9 text-muted-foreground" aria-hidden="true" />
				<h3 data-empty-title data-default={t("blog.empty")} data-filtered={t("blog.noResults")} class="text-lg font-medium">{t("blog.empty")}</h3>
				<p data-empty-description data-default={t("blog.emptyDescription")} data-filtered={t("blog.noResultsDescription")} class="mt-2 text-sm text-muted-foreground">{t("blog.emptyDescription")}</p>
				<button data-blog-reset type="button" hidden class="mt-5 cursor-pointer text-sm font-medium text-accent underline underline-offset-4">{t("blog.reset")}</button>
			</div>
		</section>
	</main>
</Layout>

<script>
	import "@/lib/client/blog";
</script>
