---
import Layout from "@/layouts/Layout.astro";
import { getLocaleFromUrl, localizePath, useTranslations } from "@/i18n";
import { blogCategories, blogCategoryStyles, blogFormats } from "@/data/blog";
import { getBlogEntries } from "@/lib/blog";
import { Icon } from "astro-icon/components";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const entries = await getBlogEntries(locale);
const dateFormat = new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric" });
const filterClass = "cursor-pointer rounded-full px-4 py-2 text-sm text-subtle-foreground transition-colors hover:bg-muted aria-pressed:bg-foreground aria-pressed:text-background focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none";
---

<Layout title={t("nav.blog")} description={t("blog.description")}>
	<main data-blog class="py-4 sm:py-8">
		<header class="max-w-2xl">
			<h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-6xl">{t("blog.heading")}</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-subtle-foreground sm:text-lg">{t("blog.description")}</p>
		</header>

		<section class="mt-10" aria-labelledby="blog-categories">
			<h2 id="blog-categories" class="sr-only">{t("blog.categories")}</h2>
			<div class="flex w-fit max-w-full gap-0.5 overflow-x-auto rounded-full bg-subtle p-[3px] [scrollbar-width:none]">
				<button type="button" data-blog-category="" aria-pressed="true" class="inline-flex shrink-0 cursor-pointer items-center gap-2 rounded-full px-4 py-1.5 text-sm font-medium text-muted-foreground transition-[color,background-color,box-shadow] hover:text-foreground aria-pressed:bg-surface aria-pressed:text-foreground aria-pressed:shadow-[0_1px_3px_#0000001f,0_1px_1px_#0000000a] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none">{t("blog.allCategories")}</button>
				{blogCategories.map((category) => {
					const { icon, surface } = blogCategoryStyles[category];
					return (
						<button type="button" data-blog-category={category} aria-pressed="false" class="inline-flex shrink-0 cursor-pointer items-center gap-2 rounded-full px-4 py-1.5 text-sm font-medium text-muted-foreground transition-[color,background-color,box-shadow] hover:text-foreground aria-pressed:bg-surface aria-pressed:text-foreground aria-pressed:shadow-[0_1px_3px_#0000001f,0_1px_1px_#0000000a] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none pl-2.5">
							<span class={`flex size-5 shrink-0 items-center justify-center rounded-md bg-linear-to-b ${surface} text-white shadow-[inset_0_1px_0_#ffffff59,0_1px_1px_#00000026]`}>
								<Icon name={icon} class="size-3" aria-hidden="true" />
							</span>
							{t(`blog.${category}`)}
						</button>
					);
				})}
			</div>
		</section>

		<div class="mt-8 border-b border-border-muted pb-5">
			<div class="flex flex-wrap gap-1" role="group" aria-label={t("blog.formats")}>
				<button type="button" data-blog-format="all" aria-pressed="true" class={filterClass}>{t("blog.all")}</button>
				{blogFormats.map((format) => <button type="button" data-blog-format={format} aria-pressed="false" class={filterClass}>{t(`blog.${format}`)}</button>)}
			</div>
		</div>

		<section class="mt-8" aria-label={t("blog.latest")}>
			<ul class="grid gap-4 md:grid-cols-2 md:gap-6">
				{entries.map((entry) => (
					<li data-blog-entry data-category={entry.data.category} data-format={entry.data.format}>
						<a href={localizePath(locale, `/blog/${entry.id}/`)} class="group relative flex h-full flex-col rounded-3xl bg-surface p-1 shadow-[0_0_0_1px_#0000000d,0_1px_2px_#0000000a] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
							<span class="relative block aspect-[556/320] shrink-0 overflow-hidden rounded-[20px] bg-background">
								<img src={entry.data.cover ?? "/images/blog/default.svg"} alt="" width="1112" height="560" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02] motion-reduce:transition-none" />
								<span class="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-surface/90 px-2.5 py-1 text-xs font-medium text-foreground shadow-[0_1px_2px_#0000001a] backdrop-blur">
									<Icon name={entry.data.format === "guide" ? "mdi:compass-outline" : entry.data.format === "article" ? "mdi:text-box-outline" : "mdi:note-text-outline"} class="size-3.5" aria-hidden="true" />
									{t(`blog.${entry.data.format}`)}
								</span>
							</span>
							<span class="flex flex-col gap-2 px-4 pt-[18px] pb-5 sm:px-5">
								<span class="line-clamp-2 text-lg leading-[26px] font-medium text-pretty text-foreground sm:text-xl sm:leading-7">{entry.data.title}</span>
								<span class="line-clamp-2 text-[15px] leading-[22px] text-pretty text-muted-foreground">{entry.data.description}</span>
								<span class="flex min-w-0 items-center gap-2 pt-1.5 text-sm leading-5">
									<img src="/favicon.svg" alt="" width="22" height="22" loading="lazy" class="size-[1.375em] shrink-0 rounded-full" />
									<span class="truncate font-medium text-foreground">{entry.data.author}</span>
									<time datetime={entry.data.pubDate.toISOString()} class="shrink-0 text-muted-foreground">{dateFormat.format(entry.data.pubDate)}</time>
								</span>
							</span>
						</a>
					</li>
				))}
			</ul>
			<div data-blog-empty hidden={entries.length > 0} class="rounded-2xl border border-dashed border-border-muted px-6 py-16 text-center">
				<Icon name="mdi:book-open-page-variant-outline" class="mx-auto mb-5 size-9 text-muted-foreground" aria-hidden="true" />
				<h3 data-empty-title data-default={t("blog.empty")} data-filtered={t("blog.noResults")} class="text-lg font-medium">{t("blog.empty")}</h3>
				<p data-empty-description data-default={t("blog.emptyDescription")} data-filtered={t("blog.noResultsDescription")} class="mt-2 text-sm text-muted-foreground">{t("blog.emptyDescription")}</p>
				<button data-blog-reset type="button" hidden class="mt-5 cursor-pointer text-sm font-medium text-accent underline underline-offset-4">{t("blog.reset")}</button>
			</div>
		</section>
	</main>
</Layout>

<script>
	import "@/lib/client/blog";
</script>
