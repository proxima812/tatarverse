---
import CenterPage from "@/components/tv/CenterPage";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Layout title={t("tv.center.title")} description={t("tv.catalog.description")} indexRobots={false} classContainer="max-w-7xl">
	<CenterPage client:only="solid-js" lang={locale} />
</Layout>
