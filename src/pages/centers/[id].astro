---
import CenterView from "@/components/centers/CenterView.astro";
import { loadCenterPage, notFoundResponse, setCenterHeaders, unavailableResponse } from "@/lib/server/centerPage";

/**
 * Страница центра - одна на все центры, рендерится по запросу (Cloudflare Workers) из API каталога
 * по коду из адреса. Нет такого центра - 404, API не ответило - 503.
 */
export const prerender = false;

const page = await loadCenterPage(Astro.params.id, "ru", Astro.url.pathname);
if (page.kind === "missing") return notFoundResponse();
if (page.kind === "redirect") return Astro.redirect(page.to, 301);
if (page.kind === "unavailable") return unavailableResponse();
setCenterHeaders(Astro.response.headers, "ru", page.card.id);
---

<CenterView card={page.card} ruCard={page.ruCard} code={page.card.id} locale="ru" related={page.related} previous={page.previous} next={page.next} />
