---
import HomeBlog from "@/components/home/HomeBlog.astro";
import HomeDemo from "@/components/home/HomeDemo.astro";
import HomeHeroBadge from "@/components/home/HomeHeroBadge.astro";
import HomeHeroTitle from "@/components/home/HomeHeroTitle.astro";
import HomeLinks from "@/components/home/HomeLinks.astro";
import HomeSections from "@/components/home/HomeSections.astro";
import { catalogStats } from "@/lib/center/stats";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const {
	count: centers,
	countries: countriesCount,
	regions: regionsCount,
} = catalogStats(await getCollection("centers"));
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Layout
	title={t("home.meta.title")}
	description={t("home.meta.description")}
	markdownURL="/index.md"
	keywords={[
		"ТБК",
		"татары",
		"башкиры",
		"крымские татары",
		"татарские центры",
		"башкирские центры",
		"крымскотатарские центры",
		"культурные центры",
		`${centers} центров`,
		`${countriesCount} стран`,
		`${regionsCount} регионов`,
	]}
>
	<main class="space-y-12">
		<div class="pt-6 md:pt-10">
			<div class="space-y-5">
				<HomeHeroBadge />
				<HomeHeroTitle />
			</div>
			<p class="mx-auto mt-6 max-w-2xl text-balance text-center text-[17px] sm:text-[20px] leading-snug text-subtle-foreground">
				{t("home.hero.description")}
			</p>
		</div>
		<div class="!mt-10">
			<HomeLinks />
		</div>

		<div class="!mt-20 md:!mt-28">
			<HomeDemo />
		</div>

		<HomeSections />

		<HomeBlog />
	</main>
</Layout>
