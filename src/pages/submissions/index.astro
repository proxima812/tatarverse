---
import MySubmissions from "@/components/tv/MySubmissions";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Layout title={t("tv.my.title")} description={t("tv.my.description")} indexRobots={false} classContainer="max-w-4xl">
	<MySubmissions client:only="solid-js" lang={locale} />
</Layout>
