{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "exactOptionalPropertyTypes": false,
    "allowJs": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "node_modules",
    ".vercel",
    ".netlify",
    "dist",
    ".wrangler",
    "article-publish",
    "workers"
  ]
}