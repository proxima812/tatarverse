{
	// Конфиг воркера для `astro dev` (astro.config.mjs → configPath): тот же, что wrangler.jsonc, но без
	// run_worker_first. В dev он отправлял бы в воркер и запросы самого Vite (/@vite/client, /src/…, файлы из
	// public), и страница приходила бы без стилей и скриптов. Markdown для ботов в dev поэтому не работает.
	"name": "tatarverse",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-05-17",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
